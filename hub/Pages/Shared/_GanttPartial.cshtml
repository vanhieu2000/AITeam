@using System.Globalization
@using AITeam.Hub.Models
@using AITeam.Hub.Services
@model AITeam.Hub.Services.GanttChart
@{
    static string F(double v) => v.ToString(CultureInfo.InvariantCulture);
    var axisBottom = Model.Height - GanttLayout.AxisHeight;
}
@if (Model.Rows.Count == 0)
{
    <div class="empty">Chưa có số đo thời gian trong khoảng này.</div>
}
else
{
    <style>.g-coding{fill:#f59e0b}.g-fix{fill:#ef4444}.g-review{fill:#a78bfa}.g-merge{fill:#22c55e}</style>
    <svg viewBox="0 0 @F(Model.Width) @F(Model.Height)" width="100%" style="min-width:640px" font-size="12">
        @foreach (var tick in Model.Ticks)
        {
            <g>
                <line x1="@F(tick.X)" y1="@F(GanttLayout.Top)" x2="@F(tick.X)" y2="@F(axisBottom)" stroke="var(--line, #e3e6eb)" stroke-width="1" />
                <text x="@F(tick.X)" y="@F(Model.Height - 6)" text-anchor="middle" fill="var(--muted, #8b949e)" font-size="11">@tick.Label</text>
            </g>
        }
        @foreach (var row in Model.Rows)
        {
            var diffText = row.Difficulty == Difficulty.Unknown ? "" : row.Difficulty.ToString();
            <g>
                <a href="/p/@row.Project/t/@row.Id"><text x="6" y="@F(row.Y + 12)" fill="currentColor">@row.Label</text></a>
                @if (!string.IsNullOrEmpty(diffText))
                {
                    <g><text x="128" y="@F(row.Y + 12)" font-size="10" fill="var(--muted, #8b949e)">@diffText</text></g>
                }
                @foreach (var bar in row.Bars)
                {
                    <rect x="@F(bar.X)" y="@F(row.Y)" width="@F(bar.Width)" height="16" rx="3" class="g-@bar.Css"><title>@bar.Tooltip</title></rect>
                }
            </g>
        }
    </svg>
}
