@model IReadOnlyList<AITeam.Hub.Models.RunningAgent>

<div class="panel" id="running-agents-panel" hx-get="/?handler=RunningAgents" hx-trigger="every 15s" hx-swap="outerHTML">
    <div class="hd">
        <span>Agent đang chạy</span>
        <span class="sp"></span>
        <a class="muted" href="/Agents" style="font-size: 12.5px;">Tất cả</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty">Không có agent nào đang chạy</div>
    }
    else
    {
        <table>
            <tbody>
                @foreach (var agent in Model)
                {
                    <tr>
                        <td style="width: 20px;"><span class="dot run"></span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(agent.Task) && !string.IsNullOrEmpty(agent.Project))
                            {
                                <a href="/p/@agent.Project/t/@agent.Task"><b>@agent.Task</b></a>
                            }
                            else
                            {
                                <b>@(agent.Task ?? "N/A")</b>
                            }
                            <span class="muted">· @(agent.Project ?? "N/A")</span>
                        </td>
                        <td style="width: 70px;"><span class="tag">PID @agent.Pid</span></td>
                        <td class="num muted">@AITeam.Hub.Pages.IndexModel.FormatElapsed(agent.Elapsed)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
