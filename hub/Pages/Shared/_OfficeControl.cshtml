@model AITeam.Hub.Pages.OfficeModel

<div id="office-control" class="panel">
    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <div class="panel" style="background:#ecfdf5;color:#047857;border-color:#10b981;margin-bottom:10px">@Model.Notice</div>
    }
    @if (!string.IsNullOrEmpty(Model.CommandError))
    {
        <div class="panel" style="border-color:#dc2626;background:#fef2f2;color:#b91c1c;margin-bottom:10px">@Model.CommandError</div>
    }
    <h4 style="margin:0 0 8px 0">Lệnh gần đây</h4>
    <div id="office-jobs">
        <partial name="_OfficeJobs" model="Model" />
    </div>
</div>
