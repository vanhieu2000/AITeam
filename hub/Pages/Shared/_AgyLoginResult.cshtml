@model AITeam.Hub.Models.HealthItem

@if (Model != null)
{
    var badgeClass = Model.Level switch
    {
        AITeam.Hub.Models.HealthLevel.Ok => "badge-success",
        AITeam.Hub.Models.HealthLevel.Warning => "badge-warning",
        AITeam.Hub.Models.HealthLevel.Error => "badge-danger",
        _ => "badge-muted"
    };

    var icon = Model.Level switch
    {
        AITeam.Hub.Models.HealthLevel.Ok => "✅",
        AITeam.Hub.Models.HealthLevel.Warning => "🟡",
        AITeam.Hub.Models.HealthLevel.Error => "🔴",
        _ => "ℹ️"
    };

    <div class="health-result-card @badgeClass">
        <div class="health-result-header">
            <span class="health-result-icon">@icon</span>
            <strong>@Model.Name</strong>
            <span class="badge @badgeClass">@Model.Level</span>
        </div>
        <div class="health-result-body">
            <p>@Model.Detail</p>
            @if (!string.IsNullOrEmpty(Model.Fix))
            {
                <div class="health-result-fix">
                    <span>Khắc phục:</span>
                    <code>@Model.Fix</code>
                </div>
            }
        </div>
    </div>
}
