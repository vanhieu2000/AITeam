@inject AITeam.Hub.Services.IApprovalService ApprovalService
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isOfficeActive = currentPage.Equals("/Office", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrEmpty(currentPage)
        || currentPage == "/";
    var isApprovalsActive = currentPage.Equals("/Approvals", StringComparison.OrdinalIgnoreCase);
    var isProjectsActive = currentPage.Equals("/Projects", StringComparison.OrdinalIgnoreCase)
        || currentPage.Equals("/Project", StringComparison.OrdinalIgnoreCase);
    var isPerformanceActive = currentPage.Equals("/Performance", StringComparison.OrdinalIgnoreCase);
    var isProcessActive = currentPage.Equals("/Process", StringComparison.OrdinalIgnoreCase);
    var isSettingsActive = currentPage.Equals("/Settings", StringComparison.OrdinalIgnoreCase);
    var isAiActive = currentPage.Equals("/AI", StringComparison.OrdinalIgnoreCase);
    var isMapActive = currentPage.Equals("/Map", StringComparison.OrdinalIgnoreCase);
    var isChatActive = currentPage.Equals("/Chat", StringComparison.OrdinalIgnoreCase);

    var pendingApprovals = ApprovalService.GetAll().Count(a => a.Status == AITeam.Hub.Models.ApprovalStatus.Pending);
    var reqTheme = Context.Request.Query["theme"].ToString();
}
<!DOCTYPE html>
<html lang="vi" @(reqTheme == "dark" ? "data-theme=\"dark\"" : "")>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - AITeam Hub" : "AITeam Hub")</title>
    <script>
        (function() {
            var urlParams = new URLSearchParams(window.location.search);
            var urlTheme = urlParams.get('theme');
            var theme = urlTheme || localStorage.getItem('hub-theme') || 'light';
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.removeAttribute('data-theme');
            }
        })();
    </script>
    <link rel="stylesheet" href="~/css/hub.css" />
    <script src="~/lib/htmx.min.js"></script>
</head>
<body>
    <div class="app">
        <!-- ===== Thanh bên trái 208px ===== -->
        <aside class="side">
            <div class="brand"><i></i>AITeam Hub</div>

            <a href="/" class="nav @(isOfficeActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 14V6.5L8 2l6 4.5V14M6 14v-4h4v4"/>
                </svg>
                <span>Văn phòng</span>
            </a>
            <a href="/Chat" class="nav @(isChatActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 2h12v9H7l-4 3v-3H2z"/></svg>
                <span>Trò chuyện AI</span>
            </a>
            <a href="/Approvals" class="nav @(isApprovalsActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2.5" y="2" width="11" height="12" rx="1.5"/>
                    <path d="M5.5 8.2l1.8 1.8 3.4-3.6"/>
                </svg>
                <span>Đơn duyệt</span>
                @if (pendingApprovals > 0)
                {
                    <span class="cnt" style="background: var(--fix); color: #fff;">@pendingApprovals</span>
                }
            </a>
            <a href="/Projects" class="nav @(isProjectsActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="12" height="12" rx="1.5"/>
                    <path d="M5 5h6M5 8h6M5 11h4"/>
                </svg>
                <span>Dự án</span>
            </a>

            <div class="grp">Đánh giá</div>
            <a href="/Performance" class="nav @(isPerformanceActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 13.5h12M4 11V7M8 11V4M12 11V8.5"/>
                </svg>
                <span>Hiệu suất</span>
            </a>
            <a href="/Process" class="nav @(isProcessActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M2 13.5h12M4 11V7M8 11V4M12 11V8.5"/>
                </svg>
                <span>Quy trình &amp; cải tiến</span>
            </a>

            <div class="grp">Hệ thống</div>
            <a href="/Settings" class="nav @(isSettingsActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="8" cy="8" r="2"/>
                    <path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/>
                </svg>
                <span>Cài đặt</span>
            </a>
            <a href="/AI" class="nav @(isAiActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="5" cy="6" r="2"/><circle cx="11" cy="6" r="2"/>
                    <path d="M1.5 13c.5-2 1.8-3 3.5-3s3 1 3.5 3M7.5 13c.5-2 1.8-3 3.5-3s3 1 3.5 3"/>
                </svg>
                <span>Tài khoản</span>
            </a>
            <a href="/Map" class="nav @(isMapActive ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polygon points="1 3 5 1 11 3 15 1 15 13 11 15 5 13 1 15"/>
                    <path d="M5 1v12M11 3v12"/>
                </svg>
                <span>Map</span>
            </a>

            <div class="foot">
                <span>v2.0</span>
                <button class="btn sm ghost" id="theme" type="button" onclick="toggleTheme()">Tối</button>
            </div>
        </aside>

        <!-- ===== Vùng chính ===== -->
        <div class="main">
            <!-- Thanh trên 52px -->
            <header class="top">
                @if (ViewData["Crumb"] != null)
                {
                    @Html.Raw(ViewData["Crumb"])
                }
                else
                {
                    <h1>@(ViewData["Title"] ?? "AITeam Hub")</h1>
                }
                <span class="sp"></span>
                @RenderSection("Actions", required: false)
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        function updateThemeUI() {
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            var themeBtn = document.getElementById('theme');
            if (themeBtn) {
                themeBtn.textContent = isDark ? 'Sáng' : 'Tối';
            }
        }
        function toggleTheme() {
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            var nextTheme = isDark ? 'light' : 'dark';
            if (nextTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('hub-theme', 'dark');
            } else {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('hub-theme', 'light');
            }
            updateThemeUI();
        }
        document.addEventListener('DOMContentLoaded', updateThemeUI);
    </script>
</body>
</html>
