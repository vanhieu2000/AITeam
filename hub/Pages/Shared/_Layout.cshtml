@inject AITeam.Hub.Services.IApprovalService ApprovalService
@{
    // R-014 (Claude): menu 3 nhóm, nút chat nổi thay mục Giao việc / Trò chuyện. Thiết kế: docs/design/R-014-van-phong-ai.md mục 3.
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool IsPage(params string[] pages) => pages.Any(p => currentPage.Equals(p, StringComparison.OrdinalIgnoreCase));

    // R-015 (Claude): menu 9 mục, 3 nhóm. Thiết kế: docs/design/R-015-ra-soat-van-phong-ai.md mục 3.
    var isOffice = string.IsNullOrEmpty(currentPage) || currentPage == "/" || IsPage("/Office");
    var isRequests = IsPage("/Requests", "/Request", "/RequestReview");
    var isApprovals = IsPage("/Approvals");
    var isTracking = IsPage("/Tracking", "/Task", "/Run");
    var isProjects = IsPage("/Projects", "/Project");
    var isAi = IsPage("/AiAccounts", "/AiServices", "/Research");
    var isReports = IsPage("/Reports", "/Lessons");
    var isWorkflow = IsPage("/Workflow");
    var isSettings = IsPage("/Settings", "/Secrets", "/Vault");

    // Chỉ đếm việc chủ dự án phải quyết (bí mật, bảo mật, dữ liệu nhạy cảm, ra ngoài, quyết định sản phẩm).
    // Merge / cải tiến là việc Claude tự quyết nên không làm sáng huy hiệu.
    var ownerPending = ApprovalService.GetAll().Count(a => a.Status == AITeam.Hub.Models.ApprovalStatus.Pending
        && a.Kind != AITeam.Hub.Models.ApprovalKind.Merge && a.Kind != AITeam.Hub.Models.ApprovalKind.Improvement);
    var reqTheme = Context.Request.Query["theme"].ToString();
    var embed = Context.Request.Query["embed"] == "1";
}
<!DOCTYPE html>
<html lang="vi" @(reqTheme == "dark" ? "data-theme=\"dark\"" : "")>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - AITeam Hub" : "AITeam Hub")</title>
    <script>
        (function() {
            var urlParams = new URLSearchParams(window.location.search);
            var theme = urlParams.get('theme');
            try { theme = theme || localStorage.getItem('hub-theme'); } catch (e) { }
            if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            else document.documentElement.removeAttribute('data-theme');
            // Trang mở trong khung trợ lý: sau khi gửi form / chuyển hướng vẫn giữ chế độ nhúng (không hiện thanh bên lồng nhau).
            try {
                if (window.self !== window.top && urlParams.get('embed') !== '1') {
                    urlParams.set('embed', '1');
                    window.location.replace(window.location.pathname + '?' + urlParams.toString() + window.location.hash);
                }
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="~/css/hub.css" asp-append-version="true" />
    <script src="~/lib/htmx.min.js"></script>
</head>
<body class="@(embed ? "embed" : "")">
    <div class="app">
        @if (!embed)
        {
        <aside class="side" aria-label="Menu chính">
            <div class="brand"><i></i>AITeam · Văn phòng AI</div>

            <div class="grp">Làm việc</div>
            <a href="/" class="nav @(isOffice ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="5" height="6"/><rect x="9" y="2" width="5" height="3.5"/><rect x="9" y="7.5" width="5" height="6.5"/><rect x="2" y="10" width="5" height="4"/></svg>
                <span>Văn phòng</span>
            </a>
            <a href="/Requests" class="nav @(isRequests ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.5 1.5h6l3 3v10h-9z"/><path d="M5.5 7.5h5M5.5 10h5M5.5 12.5h3"/></svg>
                <span>Yêu cầu</span>
            </a>
            <a href="/Approvals" class="nav @(isApprovals ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 1.5l5.5 2.5v3.5c0 3.4-2.4 5.6-5.5 6.5-3.1-.9-5.5-3.1-5.5-6.5V4z"/><path d="M5.6 8l1.7 1.7 3.1-3.3"/></svg>
                <span>Cần anh duyệt</span>
                @if (ownerPending > 0)
                {
                    <span class="cnt alert num" aria-label="@ownerPending việc chờ duyệt">@ownerPending</span>
                }
            </a>
            <a href="/Tracking" class="nav @(isTracking ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 4h11M2.5 8h7M2.5 12h4.5"/></svg>
                <span>Theo dõi việc</span>
            </a>

            <div class="grp">Quản lý</div>
            <a href="/Projects" class="nav @(isProjects ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1.5 4.5a1 1 0 011-1h3.5l1.5 1.5h6a1 1 0 011 1V12a1 1 0 01-1 1h-11a1 1 0 01-1-1z"/></svg>
                <span>Dự án</span>
            </a>
            <a href="/AiServices" class="nav @(isAi ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="10" height="10" rx="1.5"/><path d="M6 6h4v4H6zM6 1v2M10 1v2M6 13v2M10 13v2M13 6h2M13 10h2M1 6h2M1 10h2"/></svg>
                <span>Đội AI</span>
            </a>

            <div class="grp">Đánh giá &amp; cấu hình</div>
            <a href="/Reports" class="nav @(isReports ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 13.5h12M4 11V7M8 11V3.5M12 11V8.5"/></svg>
                <span>Báo cáo &amp; bài học</span>
            </a>
            <a href="/Workflow" class="nav @(isWorkflow ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="3.5" cy="8" r="1.5"/><circle cx="12.5" cy="3.5" r="1.5"/><circle cx="12.5" cy="12.5" r="1.5"/><path d="M5 8h3l3-4M8 8l3 4"/></svg>
                <span>Quy trình</span>
            </a>
            <a href="/Settings" class="nav @(isSettings ? "on" : "")">
                <svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg>
                <span>Cài đặt</span>
            </a>

            <div class="foot">
                <span>v3.0</span>
                <button class="btn sm ghost" id="theme" type="button" onclick="toggleTheme()">Tối</button>
            </div>
        </aside>
        }

        <div class="main">
            <header class="top">
                @if (ViewData["Crumb"] != null)
                {
                    @Html.Raw(ViewData["Crumb"])
                }
                else
                {
                    <h1>@(ViewData["Title"] ?? "AITeam Hub")</h1>
                }
                <span class="sp"></span>
                @RenderSection("Actions", required: false)
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (!embed && ViewData["HideFab"] is not true)
    {
    <button class="fab" id="fab" type="button" aria-label="Mở trợ lý chat" aria-expanded="false" aria-controls="chatp">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
    </button>
    @* Khung chat tải khi bấm mở lần đầu (/Assistant?handler=Panel) — trang không mang thêm form / ô chọn. *@
    <section class="chatp" id="chatp" role="dialog" aria-label="Trợ lý chat" data-lazy="1"></section>
    }
    <script src="~/js/chat-panel.js" asp-append-version="true"></script>

    <script>
        function updateThemeUI() {
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            var themeBtn = document.getElementById('theme');
            if (themeBtn) themeBtn.textContent = isDark ? 'Sáng' : 'Tối';
        }
        function toggleTheme() {
            var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            if (next === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            else document.documentElement.removeAttribute('data-theme');
            try { localStorage.setItem('hub-theme', next); } catch (e) { }
            updateThemeUI();
        }
        document.addEventListener('DOMContentLoaded', updateThemeUI);
    </script>
</body>
</html>
