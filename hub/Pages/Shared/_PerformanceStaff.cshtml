@using System.Globalization
@using AITeam.Hub.Pages
@model AITeam.Hub.Pages.TeamModel

<div class="performance-staff">
<style>
    .performance-staff, .performance-staff .panel, .performance-staff .bd { min-width:0; }
    .performance-staff { overflow-wrap:anywhere; }
    .performance-staff .hd, .performance-staff .kv-row { flex-wrap:wrap; }
    .performance-staff .h5{background:#d7f0de}.performance-staff .h4{background:#ecf7ef}.performance-staff .h3{background:#fff4d6}.performance-staff .h2{background:#fde3d6}.performance-staff .h1{background:#f8cfcf}.performance-staff .h0{color:var(--faint,#9aa1ab)}
    .performance-staff .kv-row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:5px 0;border-bottom:1px dashed var(--line,#e5e7eb);font-size:13px}
    .performance-staff .kv-row:last-child{border-bottom:none}
</style>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span>
        <span>@Model.Error</span>
    </div>
}

<section class="screen on">
    <div class="muted" style="margin-bottom: 12px; font-size: 13px;">Chỉ tính task theo quy trình mới (có phiếu R-xxx).</div>

    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr)); gap:12px;">
        @if (Model.Staff.Count == 0)
        {
            <div class="panel">
                <div class="empty">Chưa có task nào theo quy trình mới (có phiếu R-xxx).</div>
            </div>
        }
        else
        {
            @foreach (var s in Model.Staff)
            {
                <div class="panel">
                    <div class="hd">
                        <span>@s.Name</span>
                        <span class="sp"></span>
                        <span class="pill rev">Agent @s.Agent</span>
                    </div>
                    <div class="bd">
                        <div class="kv-row"><span class="muted">Task</span><b>@s.Tasks</b></div>
                        <div class="kv-row"><span class="muted">Lượt</span><b>@s.Runs</b></div>
                        <div class="kv-row"><span class="muted">Phút / lượt</span><b>@(s.AvgMinutesPerRun.ToString("0.#", CultureInfo.InvariantCulture))′</b></div>
                        <div class="kv-row"><span class="muted">Đạt cổng KT lần đầu</span><b>@TeamModel.Pct(s.VerifyFirstPassRate)</b></div>
                        <div class="kv-row"><span class="muted">Đạt vòng 1</span><b>@TeamModel.Pct(s.Round1Rate)</b></div>
                        <div class="kv-row"><span class="muted">Lỗi AG</span><span>@TeamModel.AgErrorsText(s.AgErrorsByKind)</span></div>
                    </div>
                </div>
            }
        }

        <div class="panel">
            <div class="hd"><span>Lỗi theo nguyên nhân</span></div>
            <div class="bd">
                @foreach (var code in TeamModel.Causes)
                {
                    var count = Model.CauseCounts.TryGetValue(code, out var n) ? n : 0;
                    <div class="kv-row">
                        <span><span class="pill">@code</span> @TeamModel.CauseLabel(code)</span>
                        <b>@count</b>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="panel" style="margin-top: 14px; overflow-x: auto;">
        <div class="hd"><span>Bản đồ nhiệt: điểm 7 giai đoạn theo task</span></div>
        @if (Model.HeatRows.Count == 0)
        {
            <div class="empty">Chưa có task nào được đánh giá quy trình.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Người</th>
                        <th style="text-align:center;">Tiếp nhận</th>
                        <th style="text-align:center;">Ý tưởng</th>
                        <th style="text-align:center;">Plan</th>
                        <th style="text-align:center;">Giao việc</th>
                        <th style="text-align:center;">Code</th>
                        <th style="text-align:center;">Review/QC</th>
                        <th style="text-align:center;">Đánh giá</th>
                        <th style="text-align:center;">TB</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.HeatRows)
                    {
                        <tr>
                            <td><a href="/p/@t.Project/t/@t.Id"><b>@t.Id</b></a></td>
                            <td>@t.StaffName</td>
                            @for (var idx = 1; idx <= 7; idx++)
                            {
                                var score = TeamModel.StageScoreOf(t, idx);
                                <td class="@TeamModel.HeatCss(score)" style="text-align:center;">@(score?.ToString() ?? "—")</td>
                            }
                            <td style="text-align:center;"><b>@(t.ProcessScore.HasValue ? t.ProcessScore.Value.ToString("0.0", CultureInfo.InvariantCulture) : "—")</b></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
</div>
