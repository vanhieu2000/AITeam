@model AITeam.Hub.Models.TaskCard
@using AITeam.Hub.Services

<div class="card" onclick="location.href='/p/@Model.Project/t/@Model.Id'">
    <div class="t1">
        <a href="/p/@Model.Project/t/@Model.Id">@Model.Id</a>
        <span class="sp"></span>
        <span class="tag">@(string.IsNullOrEmpty(Model.Agent) ? "A" : Model.Agent)</span>
    </div>

    <div class="tt">@Model.Title</div>

    <div class="t3">
        @if (Model.LastRun != null)
        {
            var verdict = RunVerdicts.Classify(Model.LastRun);
            if (verdict == RunVerdict.Running)
            {
                var dur = Model.LastRun.DurationSeconds.HasValue ? $" {Model.LastRun.DurationSeconds.Value:F0}s" : "";
                <span class="pill run">● Đang chạy@(dur)</span>
            }
            else if (verdict == RunVerdict.Success)
            {
                <span class="pill ok">✓ Thành công</span>
            }
            else if (verdict == RunVerdict.CreditsExhausted)
            {
                <span class="pill err">Hết credits</span>
            }
            else
            {
                <span class="pill fix">Lỗi</span>
            }

            if (Model.Runs > 0)
            {
                <span>lượt @Model.Runs</span>
            }
        }
        else
        {
            <span class="pill n">Chờ giao</span>
        }
    </div>
</div>
