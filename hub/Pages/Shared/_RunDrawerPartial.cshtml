@model AITeam.Hub.Models.AgentRun?
@if (Model != null)
{
    var verdict = AITeam.Hub.Services.RunVerdicts.Classify(Model);
    var pillClass = verdict switch
    {
        AITeam.Hub.Services.RunVerdict.Success => "pill ok",
        AITeam.Hub.Services.RunVerdict.CreditsExhausted => "pill err",
        AITeam.Hub.Services.RunVerdict.Error => "pill err",
        AITeam.Hub.Services.RunVerdict.Running => "pill run",
        _ => "pill"
    };

    <aside class="drawer on" id="drawer">
        <div class="hd">
            <span>@Model.Task · lượt @Model.Attempt</span>
            <span class="@pillClass">@AITeam.Hub.Services.RunVerdicts.Label(verdict)</span>
            <span style="flex:1"></span>
            <button type="button" class="btn sm ghost" onclick="document.getElementById('drawer').classList.remove('on')">Đóng</button>
        </div>
        <div class="bd grid" style="gap:12px">
            <dl class="kv">
                <dt>Bắt đầu</dt>
                <dd>@Model.Time.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                <dt>Thời lượng</dt>
                <dd>@(Model.DurationSeconds.HasValue ? (Model.DurationSeconds.Value >= 60 ? $"{(int)(Model.DurationSeconds.Value / 60)} phút" : $"{Model.DurationSeconds.Value:F1} giây") : "—")</dd>
                <dt>Token</dt>
                <dd>@(Model.TotalTokens.HasValue ? Model.TotalTokens.Value.ToString("N0") : "—")</dd>
                <dt>Dự án</dt>
                <dd>@Model.Project</dd>
                <dt>Log</dt>
                <dd class="mono" style="word-break:break-all;font-size:12px">@Model.LogPath</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div>
                    <b>Lỗi</b>
                    <pre>@Model.Error</pre>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Response))
            {
                <div>
                    <b>Phản hồi cuối của agent</b>
                    <pre>@Model.Response</pre>
                </div>
            }
            <div class="row" style="margin-top:8px">
                <a class="btn sm" href="/p/@Model.Project/t/@Model.Task">Xem task</a>
            </div>
        </div>
    </aside>
}
