@model AITeam.Hub.Pages.OfficeModel
@using AITeam.Hub.Services

<div id="office-desks">
@if (Model.View is { } v && v.Desks.Count > 0)
{
    <div class="office-desk-grid">
        @foreach (var d in v.Desks)
        {
            var borderColor = d.State switch
            {
                DeskState.Working => "var(--run)",
                DeskState.Review => "var(--rev)",
                DeskState.Idle => "var(--ok)",
                DeskState.Resting => "var(--err)",
                DeskState.Manager => "#7c3aed",
                _ => "var(--bd)"
            };
            var avatarColor = d.Key switch
            {
                "claude" => "#7c3aed",
                "A" => "#2563eb",
                "B" => "#0d9488",
                "C" => "#111827",
                "gate" => "#64748b",
                "research" => "#ea580c",
                _ => "#9aa1ab"
            };
            var pillClass = d.State switch
            {
                DeskState.Working => "run",
                DeskState.Review => "rev",
                DeskState.Idle => "ok",
                DeskState.Resting => "err",
                _ => "n"
            };
            var initial = string.IsNullOrEmpty(d.Name) ? "?" : d.Name[..1].ToUpperInvariant();
            <div data-desk-key="@d.Key" class="panel office-desk" style="border-left:4px solid @borderColor; margin:0; display:flex; flex-direction:column; gap:10px; min-width:0">
                <div class="row" style="justify-content:space-between; align-items:center; gap:8px">
                    <div class="row" style="gap:8px; min-width:0; flex:1">
                        <div style="width:34px; height:34px; border-radius:50%; background:@avatarColor; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; flex-shrink:0">@initial</div>
                        <div style="min-width:0">
                            <div><b>@d.Name</b></div>
                            <div class="muted" style="font-size:12px; overflow-wrap:anywhere">@d.Role</div>
                        </div>
                    </div>
                    <span class="pill @pillClass" style="flex-shrink:0">@d.StateText</span>
                </div>
                @if (d.Task is { } t)
                {
                    <div style="background:var(--s2); padding:8px 10px; border-radius:6px; font-size:13px">
                        <div>
                            @if (!string.IsNullOrEmpty(t.Project))
                            {
                                <a href="/p/@t.Project/t/@t.Id"><b>@t.Id</b></a>
                            }
                            else
                            {
                                <b>@t.Id</b>
                            }
                            @t.Title
                        </div>
                        @if (t.ElapsedMin is { } min)
                        {
                            <div class="muted" style="font-size:12px">@min phút</div>
                        }
                    </div>
                }
                @if (d.Feed.Count > 0)
                {
                    <div style="display:flex; flex-direction:column; gap:4px">
                        @foreach (var m in d.Feed)
                        {
                            <div style="font-size:12px; overflow-wrap:anywhere" title="@m.Text">
                                <b>@m.At.ToString("HH:mm")</b> @m.Text
                            </div>
                        }
                    </div>
                }
                @if (d.Key == "research")
                {
                    <div class="row" style="margin-top:auto">
                        <a class="btn sm pri" href="/Research">Mở phòng nghiên cứu</a>
                    </div>
                }
                @if (Model.ControlsEnabled && d.Key is "A" or "B" or "C")
                {
                    var assignable = Model.Assignable.Where(t => string.Equals(t.Agent, d.Key, StringComparison.OrdinalIgnoreCase)).ToList();
                    var resumable = Model.Resumable.Where(t => string.Equals(t.Agent, d.Key, StringComparison.OrdinalIgnoreCase)).ToList();
                    <form method="post" asp-page-handler="Command" hx-post="/?handler=Command" hx-target="#office-control" hx-swap="outerHTML" hx-confirm="Giao task đã chọn?">
                        <select class="inp" name="target" disabled="@(assignable.Count == 0)">
                            @foreach (var task in assignable)
                            {
                                <option value="@task.Project/@task.Id">@task.Project · @task.Id · @task.Title</option>
                            }
                            @if (assignable.Count == 0) { <option>Không có task có thể giao</option> }
                        </select>
                        <button class="btn sm" type="submit" name="command" value="@(d.Key == "C" ? "AssignCodex" : "Assign")" disabled="@(assignable.Count == 0)">Giao task</button>
                    </form>
                    <form method="post" asp-page-handler="Command" hx-post="/?handler=Command" hx-target="#office-control" hx-swap="outerHTML" hx-confirm="Giao lại task kèm góp ý?" hx-include="#office-feedback">
                        <select class="inp" name="target" disabled="@(resumable.Count == 0)">
                            @foreach (var task in resumable)
                            {
                                <option value="@task.Project/@task.Id">@task.Project · @task.Id · @task.Title</option>
                            }
                            @if (resumable.Count == 0) { <option>Không có task có thể giao lại</option> }
                        </select>
                        <button class="btn sm" type="submit" name="command" value="Resume" disabled="@(resumable.Count == 0)">Giao lại</button>
                    </form>
                }
                @if (d.Task is { } tf && !string.IsNullOrEmpty(tf.Project))
                {
                    <div class="row" style="gap:6px; margin-top:auto; flex-wrap:wrap">
                        <a class="btn sm" href="/p/@tf.Project/t/@tf.Id">Mở task</a>
                        <a class="btn sm" href="/p/@tf.Project/t/@tf.Id?tab=report">Xem báo cáo</a>
                        @if (Model.ControlsEnabled)
                        {
                            var isAgentDesk = d.Key is "A" or "B" or "C";
                            if (isAgentDesk && d.State == DeskState.Working)
                            {
                                @* hx-confirm phải nằm trên form (HTMX 2 bỏ qua hx-confirm trên nút submit) ⇒ mỗi lệnh 1 form *@
                                <form method="post" asp-page-handler="Command" hx-post="/?handler=Command" hx-target="#office-control" hx-swap="outerHTML" hx-confirm="Dừng task @tf.Id? Agent sẽ bị dừng ngay." style="display:inline; margin:0">
                                    <input type="hidden" name="target" value="@tf.Project/@tf.Id" />
                                    <button type="submit" class="btn sm danger" name="command" value="Stop">Dừng</button>
                                </form>
                            }
                            else if (d.Key == "gate")
                            {
                                <form method="post" asp-page-handler="Command" hx-post="/?handler=Command" hx-target="#office-control" hx-swap="outerHTML" hx-confirm="Chạy lại cổng kiểm tra cho @tf.Id?" style="display:inline; margin:0">
                                    <input type="hidden" name="target" value="@tf.Project/@tf.Id" />
                                    <button type="submit" class="btn sm" name="command" value="Verify">Kiểm tra lại</button>
                                </form>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <p class="muted">Chưa có dữ liệu tác nhân để hiển thị.</p>
    <button class="btn sm" disabled>Chưa thể giao việc</button>
}</div>
