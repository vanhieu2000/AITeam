@model AITeam.Hub.Pages.OfficeModel
@using AITeam.Hub.Services

@* UI-10 (Claude 04/11): thẻ bàn làm việc gọn — tên, vai trò, trạng thái, việc đang làm, 2 tin gần nhất; ô giao việc chỉ hiện khi có task. *@
<div id="office-desks">
@if (Model.View is { } v && v.Desks.Count > 0)
{
    <div class="office-desk-grid">
        @foreach (var d in v.Desks)
        {
            var stateClass = d.State switch
            {
                DeskState.Working => "s-run",
                DeskState.Review => "s-rev",
                DeskState.Idle => "s-ok",
                DeskState.Resting => "s-err",
                DeskState.Manager => "s-mgr",
                _ => "s-n"
            };
            var avatarColor = d.Key switch
            {
                "claude" => "#7c3aed",
                "A" => "#2563eb",
                "B" => "#0d9488",
                "C" => "#111827",
                "gate" => "#64748b",
                "research" => "#ea580c",
                _ => "#9aa1ab"
            };
            var pillClass = d.State switch
            {
                DeskState.Working => "run",
                DeskState.Review => "rev",
                DeskState.Idle => "ok",
                DeskState.Resting => "err",
                _ => "n"
            };
            var initial = string.IsNullOrEmpty(d.Name) ? "?" : d.Name[..1].ToUpperInvariant();
            <article data-desk-key="@d.Key" class="office-desk @stateClass">
                <header class="desk-h">
                    <span class="desk-av" style="background:@avatarColor" aria-hidden="true">@initial</span>
                    <div class="desk-who">
                        <b>@d.Name</b>
                        <small title="@d.Role">@d.Role</small>
                    </div>
                    <span class="pill @pillClass">@d.StateText</span>
                </header>
                @if (d.Task is { } t)
                {
                    <div class="desk-task">
                        <div class="desk-task-title" title="@t.Id @t.Title">
                            @if (!string.IsNullOrEmpty(t.Project))
                            {
                                <a href="/p/@t.Project/t/@t.Id"><b>@t.Id</b></a>
                            }
                            else
                            {
                                <b>@t.Id</b>
                            }
                            @t.Title
                        </div>
                        @if (t.ElapsedMin is { } min)
                        {
                            <small class="muted num">@min phút</small>
                        }
                    </div>
                }
                else if (d.Key != "research")
                {
                    <p class="desk-idle">Không có việc đang làm</p>
                }
                @if (d.Feed.Count > 0)
                {
                    <ul class="desk-feed">
                        @foreach (var m in d.Feed.Take(2))
                        {
                            <li title="@m.Text"><time class="num">@m.At.ToString("HH:mm")</time> @m.Text</li>
                        }
                    </ul>
                }
                @if (Model.ControlsEnabled && d.Key is "A" or "B" or "C")
                {
                    <partial name="_OfficeControl" model="Model" view-data="@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["OfficeDeskKey"] = d.Key })" />
                }
                @if (d.Key == "research")
                {
                    <div class="desk-actions">
                        <a class="btn sm pri" href="/Research">Mở phòng nghiên cứu</a>
                    </div>
                }
                @if (d.Task is { } tf && !string.IsNullOrEmpty(tf.Project))
                {
                    <div class="desk-actions">
                        <a class="btn sm" href="/p/@tf.Project/t/@tf.Id">Mở task</a>
                        <a class="btn sm ghost" href="/p/@tf.Project/t/@tf.Id?tab=report">Báo cáo</a>
                        @if (Model.ControlsEnabled)
                        {
                            var isAgentDesk = d.Key is "A" or "B" or "C";
                            if (isAgentDesk && d.State == DeskState.Working)
                            {
                                @* hx-confirm phải nằm trên form (HTMX 2 bỏ qua hx-confirm trên nút submit) ⇒ mỗi lệnh 1 form *@
                                <form method="post" asp-page-handler="Command" hx-post="/?handler=Command" hx-target="#office-control" hx-swap="outerHTML" hx-confirm="Dừng task @tf.Id? Agent sẽ bị dừng ngay." class="desk-inline">
                                    <input type="hidden" name="target" value="@tf.Project/@tf.Id" />
                                    <button type="submit" class="btn sm danger" name="command" value="Stop">Dừng</button>
                                </form>
                            }
                            else if (d.Key == "gate")
                            {
                                <form method="post" asp-page-handler="Command" hx-post="/?handler=Command" hx-target="#office-control" hx-swap="outerHTML" hx-confirm="Chạy lại cổng kiểm tra cho @tf.Id?" class="desk-inline">
                                    <input type="hidden" name="target" value="@tf.Project/@tf.Id" />
                                    <button type="submit" class="btn sm" name="command" value="Verify">Kiểm tra lại</button>
                                </form>
                            }
                        }
                    </div>
                }
            </article>
        }
    </div>
}
else
{
    <p class="office-empty">Chưa có dữ liệu tác nhân để hiển thị.</p>
    <button class="btn sm" disabled>Chưa thể giao việc</button>
}</div>
