@model AITeam.Hub.Pages.ProviderHealthView
@{
    var cls = Model.Tag switch
    {
        "OK" => "ok",
        "CHƯA ĐĂNG NHẬP" or "CHƯA CÀI" => "fix",
        "LỖI" => "err",
        _ => "n"
    };
}
<span class="pill @cls">@Model.Tag</span>
@if (!string.IsNullOrEmpty(Model.Detail))
{
    <span class="muted" style="margin-left: 6px; font-size: 12px;">@Model.Detail</span>
}
