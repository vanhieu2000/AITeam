@model IReadOnlyList<AITeam.Hub.Models.RunningAgent>

<div class="panel" id="running-agents-table-container" hx-get="/Agents?handler=RunningTable" hx-trigger="every 15s" hx-swap="outerHTML">
    <div class="hd">
        <span>Đang chạy</span>
        <span class="muted">@Model.Count</span>
        <span class="sp"></span>
        <span class="faint" style="font-size:12px">tự làm mới 15 giây</span>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty">Không có agent nào đang chạy</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Task</th>
                    <th>Dự án</th>
                    <th>Agent</th>
                    <th>Bắt đầu</th>
                    <th class="num">Đã chạy</th>
                    <th>PID</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var agent in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(agent.Task) && !string.IsNullOrEmpty(agent.Project))
                            {
                                <a href="/p/@agent.Project/t/@agent.Task"><b>@agent.Task</b></a>
                            }
                            else
                            {
                                <b>@(agent.Task ?? "N/A")</b>
                            }
                        </td>
                        <td>@(agent.Project ?? "N/A")</td>
                        <td><span class="tag">A</span></td>
                        <td class="muted">@agent.StartedAt.ToString("HH:mm")</td>
                        <td class="num">@AITeam.Hub.Pages.IndexModel.FormatElapsed(agent.Elapsed)</td>
                        <td class="mono muted">@agent.Pid</td>
                        <td class="num">
                            <form method="post" asp-page-handler="Stop" style="display: inline; margin: 0;" onsubmit="return confirm('Dừng agent đang làm @(agent.Task ?? $"PID {agent.Pid}")?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pid" value="@agent.Pid" />
                                <button type="submit" class="btn sm danger">Dừng</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
