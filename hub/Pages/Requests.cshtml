@page "/Requests"
@model AITeam.Hub.Pages.RequestsModel
@using AITeam.Hub.Pages
@using AITeam.Hub.Services
@{
    // R-015 (Claude): danh sách phiếu | chi tiết. Mockup docs/design/R-015-mockup.html màn "Yêu cầu".
    ViewData["Title"] = "Yêu cầu";
    var sel = Model.Selected;
    RequestProgress? prog = null;
    if (sel != null) Model.Progress.TryGetValue(sel.Id, out prog);
    var selState = sel == null ? RequestState.Open : Model.StateOf(sel);
    (string Css, string Text) StatePill(RequestState s) => s switch
    {
        RequestState.Done => ("ok", "Xong"),
        RequestState.Cancelled => ("n", "Hủy"),
        _ => ("run", "Đang làm"),
    };
    string Pill(OfficeTaskStatus s) => s switch
    {
        OfficeTaskStatus.Running or OfficeTaskStatus.Gate => "run",
        OfficeTaskStatus.Review => "rev",
        OfficeTaskStatus.NeedsFix or OfficeTaskStatus.Blocked => "fix",
        OfficeTaskStatus.Merged => "ok",
        _ => "n"
    };
    string ListUrl(string? id, string? f) => "?" + string.Join("&", new[] { id == null ? null : "id=" + Uri.EscapeDataString(id), f == null || f == "open" ? null : "f=" + f }.Where(x => x != null));
    // Bước tiến độ: Tiếp nhận · Thiết kế · AI làm · Review · Xong
    int step = 0;
    if (sel != null)
    {
        step = selState == RequestState.Done ? 5
            : prog == null || prog.Total == 0 ? (sel.Events.Count > 1 ? 2 : 1)
            : prog.AllMerged ? 4
            : prog.Review > 0 && prog.Running == 0 ? 4 : 3;
    }
    string[] steps = ["Tiếp nhận", "Thiết kế", "AI làm", "Review", "Xong"];
}
<link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />

@section Actions {
    <a class="btn sm ghost" href="/Reports/Lessons">Xem lại &amp; bài học</a>
}

<div class="pg-fit">
@if (!string.IsNullOrEmpty(Model.Message))
{
    <p class="pg-msg ok" role="status">@Model.Message</p>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p class="pg-msg err" role="alert">@Model.ErrorMessage</p>
}

<div class="pg-split">
    <section class="panel" aria-labelledby="rq-list-h">
        <div class="hd"><span id="rq-list-h">Yêu cầu</span><span class="muted num">@Model.Threads.Count</span></div>
        <details class="pg-pop" id="rq-new">
            <summary class="pg-filter"><span class="btn sm cta" role="button">+ Yêu cầu mới</span><span class="muted" style="font-size:12px">Claude nhận đầu phiên làm việc</span></summary>
            <form method="post" asp-page-handler="Send" class="pg-form">
                @Html.AntiForgeryToken()
                <label for="rq-project">Dự án</label>
                <select id="rq-project" class="inp" name="project">
                    @foreach (var p in Model.Projects) { <option value="@p.Name">@p.Name</option> }
                    <option value="@RequestsModel.NewProject">@RequestsModel.NewProject</option>
                </select>
                <label for="rq-text">Nội dung</label>
                <textarea id="rq-text" class="inp" name="text" rows="4" maxlength="4000" placeholder="Viết yêu cầu mới…"></textarea>
                <div class="pg-row"><button type="button" class="btn sm ghost" onclick="this.closest('details').open=false">Đóng</button><button type="submit" class="btn sm pri">Gửi</button></div>
            </form>
        </details>
        <nav class="pg-filter" aria-label="Lọc theo trạng thái">
            <div class="seg">
                @foreach (var (key, label) in RequestsModel.Filters)
                {
                    <a class="@(Model.Filter == key ? "on" : "")" href="@ListUrl(null, key)" aria-current="@(Model.Filter == key ? "page" : null)">@label <span class="num">@Model.CountIn(key)</span></a>
                }
            </div>
        </nav>
        <div class="pg-scroll">
            <ul class="pg-list">
                @foreach (var w in Model.Waiting)
                {
                    <li><div class="pg-item s-warn">
                        <span class="pg-l1"><b title="@w.Text">@w.Text</b><span class="pill fix">Chờ nhận</span></span>
                        <span class="pg-l2"><span>@w.Project</span><span>@(w.Time?.ToString("HH:mm dd/MM") ?? "—")</span></span>
                    </div></li>
                }
                @foreach (var t in Model.Visible)
                {
                    var st = StatePill(Model.StateOf(t));
                    Model.Progress.TryGetValue(t.Id, out var p);
                    <li><a class="@(sel?.Id == t.Id ? "on" : "") s-@(st.Css == "run" ? "run" : st.Css == "ok" ? "ok" : "off")" href="@ListUrl(t.Id, Model.Filter)" title="@t.Id · @t.Title">
                        <span class="pg-l1"><b>@t.Id @t.Title</b><span class="pill @st.Css">@st.Text</span></span>
                        <span class="pg-l2"><span>nhận @(string.IsNullOrEmpty(t.ReceivedAt) ? "—" : t.ReceivedAt.Split('·')[0].Trim())</span><span class="num">@(p == null ? "—" : $"{p.Merged}/{p.Total} task")</span></span>
                    </a></li>
                }
            </ul>
            @if (Model.Threads.Count == 0)
            {
                <p class="pg-empty">Chưa có phiếu yêu cầu nào.</p>
            }
            else if (Model.Visible.Count == 0)
            {
                <p class="pg-empty">Không có phiếu ở mục này.</p>
            }
        </div>
    </section>

    @if (sel == null)
    {
        <section class="panel"><p class="pg-empty">Chọn một phiếu bên trái, hoặc bấm “+ Yêu cầu mới”.</p></section>
    }
    else
    {
        var st = StatePill(selState);
        <div class="pg-detail">
            <section class="panel pg-head" aria-label="Phiếu đang xem">
                <h2 title="@sel.Id · @sel.Title">@sel.Id · @sel.Title</h2>
                <span class="pill @st.Css">@st.Text</span>
                <div class="pg-acts">
                    <a class="btn sm" href="@Url.Page("/RequestReview", new { id = sel.Id })">Xem lại từng bước</a>
                    <a class="btn sm ghost" href="@Url.Page("/Request", new { id = sel.Id })">Chi tiết</a>
                    @if (selState == RequestState.Open)
                    {
                        <form method="post" asp-page-handler="State" onsubmit="return confirm('Đánh dấu @sel.Id đã xong?')">
                            <input type="hidden" name="id" value="@sel.Id" /><input type="hidden" name="state" value="done" />
                            <button type="submit" class="btn sm @(prog?.AllMerged == true ? "pri" : "")" title="@(prog?.AllMerged == true ? "Mọi task đã merge" : "Còn task chưa merge")">Đánh dấu xong</button>
                        </form>
                        <form method="post" asp-page-handler="State" onsubmit="var n=prompt('Lý do hủy @sel.Id (có thể bỏ trống):',''); if(n===null) return false; this.note.value=n; return true;">
                            <input type="hidden" name="id" value="@sel.Id" /><input type="hidden" name="state" value="cancel" /><input type="hidden" name="note" value="" />
                            <button type="submit" class="btn sm ghost">Hủy phiếu</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="State" onsubmit="return confirm('Mở lại @sel.Id?')">
                            <input type="hidden" name="id" value="@sel.Id" /><input type="hidden" name="state" value="open" />
                            <button type="submit" class="btn sm ghost">Mở lại</button>
                        </form>
                    }
                </div>
                <span class="pg-sub">@(string.IsNullOrEmpty(sel.ReceivedAt) ? "" : "Nhận " + sel.ReceivedAt + " · ")@(prog == null ? sel.Status : $"{prog.Merged}/{prog.Total} task đã merge · {prog.Running} đang chạy · {prog.Review} chờ review · {prog.NeedsFix} cần sửa")</span>
            </section>

            <div class="pg-cards">
                <section class="panel" aria-labelledby="rq-ask-h">
                    <div class="hd"><span id="rq-ask-h">Anh yêu cầu</span></div>
                    <div class="pg-scroll">
                        <div class="pg-steps" role="list" aria-label="Tiến độ">
                            @for (var i = 0; i < steps.Length; i++)
                            {
                                <div role="listitem" class="@(i + 1 < step || (step == 5 && i == 4) ? "done" : i + 1 == step ? "cur" : "")">@steps[i]</div>
                            }
                        </div>
                        <p class="pg-verb">@(string.IsNullOrEmpty(sel.Verbatim) ? "(phiếu không chép lời nguyên văn)" : sel.Verbatim)</p>
                        @if (prog == null || prog.Tasks.Count == 0)
                        {
                            <p class="pg-empty">Chưa có task gắn với phiếu này (task gắn bằng dòng “Yêu cầu: @sel.Id” trong file task).</p>
                        }
                        else
                        {
                            <table class="pg-table">
                                <colgroup><col /><col class="w-s" /><col class="w-s" /></colgroup>
                                <thead><tr><th scope="col">Task</th><th scope="col">Dự án</th><th scope="col">Trạng thái</th></tr></thead>
                                <tbody>
                                @foreach (var tk in prog.Tasks)
                                {
                                    <tr>
                                        <td class="pg-wrap"><a href="/p/@Uri.EscapeDataString(tk.Project)/t/@Uri.EscapeDataString(tk.Code)"><b>@tk.Code</b></a> @tk.Title</td>
                                        <td>@tk.Project</td>
                                        <td><span class="pill @Pill(tk.Status)">@WorkOverviewService.Label(tk.Status)</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                    </div>
                </section>

                <section class="panel" aria-labelledby="rq-log-h">
                    <div class="hd"><span id="rq-log-h">Nhật ký</span><span class="muted num">@sel.Events.Count</span></div>
                    <div class="pg-scroll">
                        @if (sel.Events.Count == 0)
                        {
                            <p class="pg-empty">Chưa có dòng nhật ký.</p>
                        }
                        <ul class="pg-tl">
                            @foreach (var e in sel.Events.Reverse())
                            {
                                <li title="@e.Text @e.Note"><time class="num">@e.Time</time><span class="pg-t">@e.Text@if (!string.IsNullOrEmpty(e.Note)) {<small>@e.Note</small>}</span></li>
                            }
                        </ul>
                    </div>
                </section>
            </div>
        </div>
    }
</div>
</div>
