@page
@model AITeam.Hub.Pages.AccountsModel
@{
    ViewData["Title"] = "Tài khoản";
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(46, 160, 67, 0.15); border: 1px solid var(--ok); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--ok); margin-right: 8px;">✓</span>
        <span>@Model.Message</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

<section class="screen on" id="s-accounts">
    <div class="acc">
        <!-- Khối 1: GitHub -->
        <div class="panel">
            <div class="hd">
                <span>GitHub</span>
                <span class="sp"></span>
                <span class="info" title="Trạng thái đăng nhập GitHub CLI và chủ sở hữu kho mã nguồn (owner).">i</span>
            </div>
            <div class="bd">
                @{
                    var ghDot = Model.GitHubHealth?.Level switch
                    {
                        AITeam.Hub.Models.HealthLevel.Ok => "dot ok",
                        AITeam.Hub.Models.HealthLevel.Warning => "dot fix",
                        _ => "dot err"
                    };
                }
                <div class="state">
                    <span class="@ghDot"></span>
                    <span>@(string.IsNullOrEmpty(Model.GitHubOwner) ? "Chưa kết nối" : Model.GitHubOwner)</span>
                </div>
                <dl class="kv">
                    <dt>Chủ kho</dt>
                    <dd>@(string.IsNullOrEmpty(Model.GitHubOwner) ? "(chưa đặt)" : Model.GitHubOwner)</dd>
                    <dt>Trạng thái</dt>
                    <dd>@(Model.GitHubHealth?.Detail ?? "Không có thông tin")</dd>
                </dl>
                @if (Model.GitHubHealth?.Fix != null)
                {
                    <div style="font-size: 12px; margin-top: 6px;">
                        <span class="muted">Cách sửa: </span><code>@Model.GitHubHealth.Fix</code>
                    </div>
                }
            </div>
        </div>

        <!-- Khối 2: Antigravity -->
        <div class="panel">
            <div class="hd">
                <span>Antigravity</span>
                <span class="sp"></span>
                <span class="info" title="Công cụ AI agent thực thi task. Dùng AntigravityManager để quản lý tài khoản và hạn mức.">i</span>
            </div>
            <div class="bd">
                @{
                    var agyDot = Model.AgyHealth?.Level switch
                    {
                        AITeam.Hub.Models.HealthLevel.Ok => "dot ok",
                        AITeam.Hub.Models.HealthLevel.Warning => "dot fix",
                        _ => "dot err"
                    };
                }
                <div class="state">
                    <span class="@agyDot"></span>
                    <span>@(Model.AgyHealth?.Detail ?? "CLI")</span>
                </div>
                <dl class="kv">
                    <dt>Credits</dt>
                    <dd>
                        @if (Model.AgyStatus.CreditsExhausted)
                        {
                            <span style="color: var(--err); font-weight: 600;">Hết credits lúc @Model.AgyStatus.At?.ToString("HH:mm")</span>
                            <div class="muted" style="font-size: 11.5px;">Task @Model.AgyStatus.Task (@Model.AgyStatus.Project)</div>
                        }
                        else
                        {
                            <span style="color: var(--ok); font-weight: 500;">Ổn</span>
                        }
                    </dd>
                    <dt>Tài khoản</dt>
                    <dd>
                        @(Model.AgyAccounts.Count > 0 ? string.Join(", ", Model.AgyAccounts) : "(mặc định)")
                    </dd>
                </dl>
                <div class="row" style="gap: 8px; margin-top: 8px;">
                    <form method="post" asp-page-handler="CheckAgyLogin" hx-post="/Accounts?handler=CheckAgyLogin" hx-target="#agy-check-result" hx-indicator="#agy-spinner" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn sm">Kiểm tra</button>
                    </form>
                    <form method="post" asp-page-handler="SwitchAccount" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn sm">Đổi tài khoản</button>
                    </form>
                    <span class="info" title="Khi cửa sổ Antigravity mở ra, gõ /logout → đăng nhập tài khoản khác → gõ /quit để hoàn tất.">i</span>
                </div>
                <div id="agy-spinner" class="htmx-indicator faint" style="font-size: 12px; margin-top: 4px;">
                    ⏳ Đang ping Antigravity...
                </div>
                <div id="agy-check-result">
                    @if (Model.AgyLoginCheckResult != null)
                    {
                        <partial name="_AgyLoginResult" model="Model.AgyLoginCheckResult" />
                    }
                </div>
            </div>
        </div>

        <!-- Khối 3: Claude -->
        <div class="panel">
            <div class="hd">
                <span>Claude</span>
                <span class="sp"></span>
                <span class="info" title="Quản lý / Tech lead của team AI. Sổ tay quản lý đặt tại ~/.claude/CLAUDE.md.">i</span>
            </div>
            <div class="bd">
                @{
                    var claudeDot = Model.ClaudeHealth?.Level switch
                    {
                        AITeam.Hub.Models.HealthLevel.Ok => "dot ok",
                        AITeam.Hub.Models.HealthLevel.Warning => "dot fix",
                        _ => "dot err"
                    };
                }
                <div class="state">
                    <span class="@claudeDot"></span>
                    <span>@(Model.ClaudeHealth?.Detail ?? "Đã gắn quy trình team")</span>
                </div>
                <dl class="kv">
                    <dt>Skill</dt>
                    <dd class="mono">aiteam</dd>
                    <dt>Sổ tay</dt>
                    <dd class="mono">~/.claude/CLAUDE.md</dd>
                    <dt>Hạn mức</dt>
                    <dd>
                        <span>xem bằng <code class="mono">/usage</code></span>
                        <span class="info" title="Anthropic không có API công khai cho hạn mức gói Claude Code; Hub không đọc token Claude.">i</span>
                    </dd>
                </dl>
                <div style="margin-top: 8px;">
                    <form method="post" asp-page-handler="InstallClaude" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn sm">Cài / sửa</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
