@page "/AI"
@model AITeam.Hub.Pages.AIModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AI & tài khoản";
}

<div class="row" style="justify-content: space-between; align-items: center; margin-bottom: 14px;">
    <h2>AI &amp; tài khoản</h2>
</div>

<nav class="row" style="gap: 8px; margin-bottom: 14px;" aria-label="Các tab AI">
    <a class="btn @(Model.Tab == "status" ? "pri" : "")" href="/AI?tab=status" aria-current="@(Model.Tab == "status" ? "page" : null)">Trạng thái</a>
    <a class="btn @(Model.Tab == "roles" ? "pri" : "")" href="/AI?tab=roles" aria-current="@(Model.Tab == "roles" ? "page" : null)">Phân vai</a>
    <a class="btn @(Model.Tab == "antigravity" ? "pri" : "")" href="/AI?tab=antigravity" aria-current="@(Model.Tab == "antigravity" ? "page" : null)">Đổi tài khoản Antigravity</a>
    <a class="btn @(Model.Tab == "history" ? "pri" : "")" href="/AI?tab=history" aria-current="@(Model.Tab == "history" ? "page" : null)">Lịch sử nghỉ</a>
</nav>

@if (Model.Tab == "status")
{
    <partial name="_AiStatus" model="Model" />
}
else if (Model.Tab == "roles")
{
    <div class="panel" style="padding: 16px;">
        <p class="muted" style="margin-bottom: 12px;">Phân vai AI trong dây chuyền (routing) — tạm xem ở trang Provider (H6-09 đưa vào đây).</p>
        <a class="btn pri" href="/Providers">Mở trang Provider AI (/Providers)</a>
    </div>
}
else if (Model.Tab == "antigravity")
{
    <div class="panel" style="padding: 16px;">
        <p class="muted" style="margin-bottom: 12px;">Kiểm tra đăng nhập / đổi tài khoản Antigravity — tạm ở trang riêng (H6-09 đưa vào đây).</p>
        <a class="btn pri" href="/Accounts">Mở trang Tài khoản Antigravity (/Accounts)</a>
    </div>
}
else if (Model.Tab == "history")
{
    <div class="panel" style="padding: 16px;">
        <p class="muted" style="margin-bottom: 12px;">Lịch sử AI nghỉ do hết hạn mức — tạm xem ở trang Provider (H6-09 đưa vào đây).</p>
        <a class="btn pri" href="/Providers">Mở trang Provider AI (/Providers)</a>
    </div>
}
