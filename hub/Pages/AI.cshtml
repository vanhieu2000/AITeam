@page "/AI"
@model AITeam.Hub.Pages.AIModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AI & tài khoản";
}

<div class="row" style="justify-content: space-between; align-items: center; margin-bottom: 14px;">
    <h2>AI &amp; tài khoản</h2>
</div>

<nav class="row" style="gap: 8px; margin-bottom: 14px;" aria-label="Các tab AI">
    <a class="btn @(Model.Tab == "status" ? "pri" : "")" href="/AI?tab=status" aria-current="@(Model.Tab == "status" ? "page" : null)">Trạng thái</a>
    <a class="btn @(Model.Tab == "accounts" ? "pri" : "")" href="/AI?tab=accounts" aria-current="@(Model.Tab == "accounts" ? "page" : null)">Tài khoản</a>
    <a class="btn @(Model.Tab == "providers" ? "pri" : "")" href="/AI?tab=providers" aria-current="@(Model.Tab == "providers" ? "page" : null)">Nhà cung cấp</a>
    <a class="btn @(Model.Tab == "vault" ? "pri" : "")" href="/AI?tab=vault" aria-current="@(Model.Tab == "vault" ? "page" : null)">Kho bí mật</a>
</nav>

@if (Model.Tab == "status")
{
    <partial name="_AiStatus" model="Model" />
}
else if (Model.Tab == "accounts")
{
    <div class="panel" style="padding: 16px;">
        <p class="muted" style="margin-bottom: 12px;">Quản lý tài khoản AI chi tiết tại trang riêng.</p>
        <a class="btn pri" href="/AiAccounts">Mở trang Tài khoản AI (/AiAccounts)</a>
    </div>
}
else if (Model.Tab == "providers")
{
    <div class="panel" style="padding: 16px;">
        <p class="muted" style="margin-bottom: 12px;">Quản lý danh sách nhà cung cấp AI tại trang riêng.</p>
        <a class="btn pri" href="/Providers">Mở trang Nhà cung cấp (/Providers)</a>
    </div>
}
else if (Model.Tab == "vault")
{
    <div class="panel" style="padding: 16px;">
        <p class="muted" style="margin-bottom: 12px;">Quản lý kho bí mật tại trang riêng.</p>
        <a class="btn pri" href="/Vault">Mở trang Kho bí mật (/Vault)</a>
    </div>
}
