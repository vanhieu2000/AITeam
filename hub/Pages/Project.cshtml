@page "/p/{name}"
@model AITeam.Hub.Pages.ProjectModel
@using AITeam.Hub.Services
@using AITeam.Hub.Pages.Shared
@{
    var projectName = Model.Work?.Project.Name ?? Model.Board?.Project.Name ?? Model.Name;
    ViewData["Title"] = projectName;
    var stack = Model.Work?.Project.Stack ?? Model.Board?.Project.Stack;
    var stackTag = string.IsNullOrEmpty(stack)
        ? ""
        : $"<span class=\"tag\">{Html.Encode(stack)}</span>";
    ViewData["Crumb"] = $"<span class=\"crumb\"><a href=\"/\" style=\"color:var(--muted)\">Dự án</a> / </span><h1>{Html.Encode(projectName)}</h1>{stackTag}";
    var githubUrl = Model.Work?.Project.GitHubUrl ?? Model.Board?.Project.GitHubUrl;
    string[] stepLabels = ["Tiếp nhận", "Kế hoạch", "Duyệt kế hoạch", "Chuẩn bị", "Code", "Cổng KT", "QC", "Nghiệm thu", "Merge"];

}

@if (Model.Work == null && Model.Board == null && string.IsNullOrEmpty(Model.WorkError))
{
    <div class="panel" style="max-width: 600px; margin: 40px auto; text-align: center; padding: 30px;">
        <h2>Không tìm thấy dự án "@Model.Name"</h2>
        <p class="muted" style="margin: 14px 0 20px;">Dự án không có trong cấu hình team hoặc đường dẫn không tồn tại.</p>
        <a href="/" class="btn pri">Quay lại Văn phòng</a>
    </div>
}
else
{
    @section Actions {
        <a class="btn sm" href="/Tracking?project=@Uri.EscapeDataString(Model.Name)">Theo dõi việc</a>
        @if (!string.IsNullOrEmpty(githubUrl))
        {
            <a class="btn sm" href="@githubUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
        }
    }

    <div class="project-page work-page" data-work-page style="display:flex; flex-direction:column; min-height:0;">
        <!-- Thanh Tab: Việc · Kế hoạch · Lịch sử chạy -->
        <div class="tabs" style="flex:none; margin-bottom:12px;">
            <span class="tab @(Model.Tab == "work" ? "on" : "")" id="tabWorkBtn" onclick="switchProjectTab('work')">Việc</span>
            <span class="tab @(Model.Tab == "plan" ? "on" : "")" id="tabPlanBtn" onclick="switchProjectTab('plan')">Kế hoạch</span>
            <span class="tab @(Model.Tab == "runs" ? "on" : "")" id="tabRunsBtn" onclick="switchProjectTab('runs')">Lịch sử chạy<span class="c">@Model.Runs.Count</span></span>
        </div>

        <!-- Tab 1: Việc -->
        <div id="tabWorkContent" style="display:@(Model.Tab == "work" ? "block" : "none"); flex:1; min-height:0;">
            @if (!string.IsNullOrEmpty(Model.WorkError))
            {
                <div class="panel" style="padding: 24px; text-align: center;">
                    <p class="muted">@Model.WorkError</p>
                </div>
            }
            else if (Model.Work == null || Model.Work.Requests.Count == 0)
            {
                <div class="panel" style="padding: 24px; text-align: center;">
                    <p class="muted">Chưa có việc.</p>
                </div>
            }
            else
            {
                <div class="work-workspace">
                    <!-- Danh sách yêu cầu (trái 38%) -->
                    <section class="work-list" aria-label="Danh sách yêu cầu">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                            <h2 style="font-size:11px; letter-spacing:.08em; color:var(--muted); margin:0;">YÊU CẦU</h2>
                            <small class="muted">@Model.Work.Requests.Count yêu cầu</small>
                        </div>
                        @foreach (var req in Model.Work.Requests)
                        {
                            var isReqSelected = string.Equals(req.Id, Model.SelectedRequest?.Id, StringComparison.OrdinalIgnoreCase);
                            var doneTasks = req.Tasks.Count(t => t.Progress.IsMerged);
                            var totalTasks = req.Tasks.Count;
                            <article class="card work-card @(isReqSelected ? "selected" : "")" data-work-request="@req.Id">
                                <a class="work-request" href="/p/@Model.Name?requestId=@req.Id">
                                    <span class="work-code">@req.Id</span>
                                    <strong>@req.Title</strong>
                                </a>
                                <div class="work-chips">
                                    <span class="pill n">@doneTasks/@totalTasks task xong</span>
                                    <span class="pill @(req.Progress.IsMerged ? "ok" : "run")">@(req.Progress.IsMerged ? "✓ Đã Merge" : (totalTasks == 0 ? "Kế hoạch · chờ duyệt" : "Đang chạy"))</span>
                                </div>
                                @if (totalTasks > 0)
                                {
                                    <details @(isReqSelected ? "open" : "")>
                                        <summary>@totalTasks task · xem công việc thành phần</summary>
                                        <div class="work-tasks">
                                            @foreach (var t in req.Tasks)
                                            {
                                                var isTaskActive = isReqSelected && string.Equals(t.Id, Model.SelectedTask?.Id, StringComparison.OrdinalIgnoreCase);
                                                var isTaskFailed = t.Progress.Steps.Any(s => s.State == WorkStepState.Failed);
                                                var taskStatusText = t.Progress.IsMerged ? "✓ Merge" : (isTaskFailed ? "CẦN SỬA" : "Đang chạy");
                                                var taskPillClass = t.Progress.IsMerged ? "ok" : (isTaskFailed ? "err" : "run");
                                                <a class="work-task @(isTaskActive ? "active" : "")" href="/p/@Model.Name?requestId=@req.Id&taskId=@t.Id" title="@t.Title">
                                                    <span class="work-code">@t.Id</span>
                                                    <span class="person">@t.Agent</span>
                                                    <span class="pill @taskPillClass">@taskStatusText</span>
                                                </a>
                                            }
                                        </div>
                                    </details>
                                }
                                else
                                {
                                    <div class="work-chips">
                                        <small class="muted">Chưa tách task · chờ duyệt kế hoạch.</small>
                                    </div>
                                }
                            </article>
                        }
                    </section>

                    <!-- Chi tiết việc (phải 62%) -->
                    @if (Model.SelectedRequest != null)
                    {
                        <section class="detail work-detail" id="detail" aria-label="Chi tiết việc" data-selected-request="@Model.SelectedRequest.Id" @if (Model.SelectedTask != null) { <text>data-selected-task="@Model.SelectedTask.Id"</text> }>
                            <header class="detailhead" style="display:flex; align-items:flex-start; gap:10px; margin-bottom:14px;">
                                <div class="work-detail-title">
                                    <div class="eyebrow" style="font-size:12px; color:var(--muted); margin-bottom:5px;">@Model.SelectedRequest.Id / @(Model.SelectedTask != null ? "Task thành phần" : "Yêu cầu")</div>
                                    <h2 style="font-size:18px; line-height:1.4; margin:0;">@(Model.SelectedTask != null ? Model.SelectedTask.Id : Model.SelectedRequest.Id) · @(Model.SelectedTask != null ? Model.SelectedTask.Title : Model.SelectedRequest.Title)</h2>
                                    <p class="description" style="font-size:12px; color:var(--muted); margin:6px 0 0;">@(Model.SelectedTask != null ? "Tiến độ riêng của task đang chọn" : "Theo dõi tổng hợp; chọn task để xem tiến độ riêng.")</p>
                                </div>
                                <span class="pill @(Model.SelectedProgress?.IsMerged == true ? "ok" : "run")" style="margin-left:auto; flex-shrink:0;">@(Model.SelectedProgress?.IsMerged == true ? "✓ Xong" : "Đang chạy")</span>
                            </header>

                            <!-- Thanh chín bước -->
                            <div class="panel" style="padding:16px; margin-bottom:12px; background:var(--surface); border:1px solid var(--line); border-radius:var(--r);">
                                <h3 class="sectiontitle" style="font-size:12px; font-weight:600; margin:0 0 14px;">Tiến trình công việc</h3>
                                <ol class="work-steps">
                                    @for (int i = 0; i < 9; i++)
                                    {
                                        var stepEnum = (WorkStep)i;
                                        var stepItem = Model.SelectedProgress?.Steps.FirstOrDefault(s => s.Step == stepEnum);
                                        var isCurrent = Model.SelectedProgress?.CurrentStep == stepEnum;
                                        var isDone = stepItem?.State == WorkStepState.Done;
                                        var isFailed = stepItem?.State == WorkStepState.Failed;
                                        var stepTime = stepItem?.TimeText;
                                        var stepActor = stepItem?.ActorText;

                                        var stepClass = (isCurrent ? "current " : "") + (isDone ? "done" : (isFailed ? "failed" : ""));
                                        <li class="work-step @stepClass" data-work-step="@i" @if (isCurrent) { <text>aria-current="step"</text> }>
                                            <span class="work-circle">@(i + 1)@(isDone ? " ✓" : (isFailed ? " ✗" : ""))</span>
                                            <span class="work-label">@stepLabels[i]</span>
                                            @if (isFailed)
                                            {
                                                <span class="work-state err" style="display:block; font-size:10px; color:var(--err); font-weight:600;">CẦN SỬA</span>
                                            }
                                            @if (!string.IsNullOrEmpty(stepTime) && stepTime != "Chưa có dữ liệu")
                                            {
                                                <span class="work-time" style="display:block; font-size:10px; color:var(--muted);">@stepTime</span>
                                            }
                                            @if (!string.IsNullOrEmpty(stepActor) && stepActor != "Chưa có dữ liệu")
                                            {
                                                <span class="work-actor" style="display:block; font-size:10px; color:var(--muted);">@stepActor</span>
                                            }
                                            @if (isCurrent)
                                            {
                                                <span class="here" style="display:block; font-size:9px; color:var(--accent);">Đang ở đây</span>
                                            }
                                        </li>
                                    }
                                </ol>
                            </div>

                            <!-- Bước hiện tại -->
                            @{
                                var currStep = Model.SelectedProgress?.CurrentStep ?? WorkStep.Received;
                                var currStepItem = Model.SelectedProgress?.Steps.FirstOrDefault(s => s.Step == currStep);
                                var actor = currStepItem?.ActorText ?? "Chưa có dữ liệu";
                                var time = currStepItem?.TimeText ?? "Chưa có dữ liệu";
                                var isMerged = Model.SelectedProgress?.IsMerged == true;
                                var isFailedStep = currStepItem?.State == WorkStepState.Failed;

                                var currentPill = isMerged ? "Hoàn tất" : (isFailedStep ? "CẦN SỬA" : "Đang chờ");
                            }
                            <section class="panel currentcard" style="padding:16px; margin-bottom:12px; background:var(--surface); border:1px solid var(--line); border-left:3px solid var(--accent); border-radius:var(--r);">
                                <p class="sectiontitle" style="font-size:12px; font-weight:600; margin:0 0 10px;">Bước hiện tại</p>
                                <div class="currenttitle" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                                    <h3 style="font-size:15px; margin:0;">@stepLabels[(int)currStep]</h3>
                                    <span class="pill @(isMerged ? "ok" : (isFailedStep ? "err" : "run"))">@currentPill</span>
                                </div>
                                <dl class="metadata work-meta">
                                    <div>
                                        <dt>Người phụ trách</dt>
                                        <dd>@actor</dd>
                                    </div>
                                    <div>
                                        <dt>Thời gian</dt>
                                        <dd>@time</dd>
                                    </div>
                                </dl>
                            </section>

                            <!-- Lỗi gần nhất nếu có -->
                            @if (!string.IsNullOrEmpty(Model.SelectedProgress?.LatestError) || isFailedStep)
                            {
                                <section class="panel errorcard work-errorcard">
                                    <h3>✗ Lỗi gần nhất · CẦN SỬA</h3>
                                    <p>@(Model.SelectedProgress?.LatestError ?? "CẦN SỬA")</p>
                                </section>
                            }
                            <section class="panel work-journal" aria-label="Nhật ký gần nhất">
                                <h3 class="sectiontitle">Nhật ký gần nhất</h3>
                                @{
                                    var recentEvents = Model.SelectedProgress?.RecentEvents ?? [];
                                }
                                @if (recentEvents.Count == 0)
                                {
                                    <p class="muted">Chưa có dữ liệu</p>
                                }
                                else
                                {
                                    <ol class="work-timeline">
                                        @foreach (var entry in recentEvents)
                                        {
                                            var eventStep = entry.Action switch
                                            {
                                                WorkAction.Prep => "Chuẩn bị", WorkAction.Assign => "Code",
                                                WorkAction.Verify => "Cổng KT", WorkAction.Qc => "QC",
                                                WorkAction.Merge => "Merge", _ => "Chưa có dữ liệu"
                                            };
                                            <li><time>@(entry.Time?.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM", System.Globalization.CultureInfo.InvariantCulture) ?? "Chưa có dữ liệu")</time> · <b>@eventStep</b> · lượt @entry.Round · @entry.Text</li>
                                        }
                                    </ol>
                                }
                            </section>
                        </section>
                    }
                </div>
            }
        </div>

        <!-- Tab 2: Kế hoạch -->
        <div id="tabPlanContent" style="display:@(Model.Tab == "plan" ? "block" : "none"); flex:1; min-height:0; overflow-y:auto;">
            <div class="panel" style="min-height:100%;">
                <div class="hd">Kế hoạch triển khai</div>
                <div class="bd markdown-body">
                    @if (string.IsNullOrWhiteSpace(Model.Board?.PlanMarkdown))
                    {
                        <div class="empty">Chưa có kế hoạch cho dự án này</div>
                    }
                    else
                    {
                        @MarkdownRenderer.Render(Model.Board.PlanMarkdown)
                    }
                </div>
            </div>
        </div>

        <!-- Tab 3: Lịch sử chạy -->
        <div id="tabRunsContent" style="display:@(Model.Tab == "runs" ? "block" : "none"); flex:1; min-height:0; overflow-y:auto;">
            <div class="panel" style="min-height:100%;">
                <div class="hd">Lịch sử chạy<span class="sp"></span><span class="muted">@Model.Runs.Count lần</span></div>
                @if (Model.Runs.Count == 0)
                {
                    <div class="empty">Chưa có lần chạy nào cho dự án này</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Lượt</th>
                                <th>Kết quả</th>
                                <th class="num">Thời lượng</th>
                                <th class="num">Token</th>
                                <th>Lúc</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Runs)
                            {
                                var verdict = RunVerdicts.Classify(r);
                                var pillClass = verdict switch
                                {
                                    RunVerdict.Running => "pill run",
                                    RunVerdict.Success => "pill ok",
                                    RunVerdict.CreditsExhausted => "pill err",
                                    _ => "pill fix"
                                };
                                var verdictText = RunVerdicts.Label(verdict);
                                var duration = r.DurationSeconds.HasValue
                                    ? (r.DurationSeconds.Value >= 60 ? $"{(int)(r.DurationSeconds.Value / 60)}′" : $"{r.DurationSeconds.Value:F0}s")
                                    : "-";
                                var tokens = r.TotalTokens.HasValue
                                    ? (r.TotalTokens.Value >= 1_000_000 ? $"{r.TotalTokens.Value / 1_000_000.0:F2} tr" : (r.TotalTokens.Value >= 1_000 ? $"{r.TotalTokens.Value / 1_000.0:F1}k" : r.TotalTokens.Value.ToString("N0")))
                                    : "-";

                                <tr style="cursor:pointer" onclick="location.href='/p/@r.Project/t/@r.Task'">
                                    <td><b>@r.Task</b></td>
                                    <td>#@r.Attempt</td>
                                    <td><span class="@pillClass">@verdictText</span></td>
                                    <td class="num">@duration</td>
                                    <td class="num">@tokens</td>
                                    <td class="muted">@r.Time.ToString("HH:mm dd/MM")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <script>
        function switchProjectTab(tab) {
            document.querySelectorAll('.project-page .tabs .tab').forEach(function(t) {
                t.classList.remove('on');
            });

            var workContent = document.getElementById('tabWorkContent');
            var planContent = document.getElementById('tabPlanContent');
            var runsContent = document.getElementById('tabRunsContent');

            if (workContent) workContent.style.display = 'none';
            if (planContent) planContent.style.display = 'none';
            if (runsContent) runsContent.style.display = 'none';

            if (tab === 'plan') {
                if (planContent) planContent.style.display = 'block';
                var btn = document.getElementById('tabPlanBtn');
                if (btn) btn.classList.add('on');
            } else if (tab === 'runs') {
                if (runsContent) runsContent.style.display = 'block';
                var btn = document.getElementById('tabRunsBtn');
                if (btn) btn.classList.add('on');
            } else {
                if (workContent) workContent.style.display = 'block';
                var btn = document.getElementById('tabWorkBtn');
                if (btn) btn.classList.add('on');
            }
        }
    </script>
}