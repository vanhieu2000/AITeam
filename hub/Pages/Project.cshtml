@page "/p/{name}"
@model AITeam.Hub.Pages.ProjectModel
@using AITeam.Hub.Services
@using AITeam.Hub.Pages.Shared
@{
    ViewData["Title"] = Model.Board?.Project.Name ?? $"Dự án {Model.Name}";
    if (Model.Board != null)
    {
        var stackTag = string.IsNullOrEmpty(Model.Board.Project.Stack)
            ? ""
            : $"<span class=\"tag\">{Html.Encode(Model.Board.Project.Stack)}</span>";
        ViewData["Crumb"] = $"<span class=\"crumb\"><a href=\"/\" style=\"color:var(--muted)\">Dự án</a> / </span><h1>{Html.Encode(Model.Board.Project.Name)}</h1>{stackTag}";
    }
}

@if (Model.Board == null)
{
    <div class="panel" style="max-width: 600px; margin: 40px auto; text-align: center; padding: 30px;">
        <h2>Không tìm thấy dự án "@Model.Name"</h2>
        <p class="muted" style="margin: 14px 0 20px;">Dự án không có trong cấu hình team hoặc đường dẫn không tồn tại.</p>
        <a href="/" class="btn pri">Quay lại Tổng quan</a>
    </div>
}
else
{
    @section Actions {
        @if (!string.IsNullOrEmpty(Model.Board.Project.GitHubUrl))
        {
            <a class="btn sm" href="@Model.Board.Project.GitHubUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
        }
        <button class="btn sm" type="button" title="@Model.Board.Project.Path">Mở thư mục</button>
        <button class="btn sm pri" type="button">+ Task</button>
    }

    <div class="project-page" style="display:flex; flex-direction:column; height:calc(100vh - 52px - 32px); overflow:hidden;">
        <!-- Thanh Tab: Bảng việc · Kế hoạch · Lịch sử chạy -->
        <div class="tabs" style="flex:none; margin-bottom:12px;">
            <span class="tab on" id="tabBoardBtn" onclick="switchProjectTab('board')">Bảng việc</span>
            <span class="tab" id="tabPlanBtn" onclick="switchProjectTab('plan')">Kế hoạch</span>
            <span class="tab" id="tabRunsBtn" onclick="switchProjectTab('runs')">Lịch sử chạy<span class="c">@Model.Runs.Count</span></span>
        </div>

        <!-- Tab 1: Bảng việc (Kanban 3 cột thẻ + 1 cột Đã merge dạng danh sách) -->
        <div id="tabBoardContent" style="flex:1; min-height:0; display:flex; flex-direction:column;">
            <div class="board" style="flex:1; height:100%; min-height:0; align-items:stretch;">
                <!-- Cột 1: Đang làm -->
                <div class="col" style="height:100%; display:flex; flex-direction:column; min-height:0;">
                    <div class="h"><span class="dot run"></span>Đang làm<span class="c">@Model.AssignedTasks.Count</span></div>
                    <div class="col-tasks" style="flex:1; overflow-y:auto; padding-right:2px;">
                        @if (Model.AssignedTasks.Count == 0)
                        {
                            <div class="empty">Trống</div>
                        }
                        else
                        {
                            @foreach (var task in Model.AssignedTasks)
                            {
                                @await Html.PartialAsync("_TaskCardPartial", task)
                            }
                        }
                    </div>
                </div>

                <!-- Cột 2: Chờ review -->
                <div class="col" style="height:100%; display:flex; flex-direction:column; min-height:0;">
                    <div class="h"><span class="dot rev"></span>Chờ review<span class="c">@Model.ReviewTasks.Count</span></div>
                    <div class="col-tasks" style="flex:1; overflow-y:auto; padding-right:2px;">
                        @if (Model.ReviewTasks.Count == 0)
                        {
                            <div class="empty">Trống</div>
                        }
                        else
                        {
                            @foreach (var task in Model.ReviewTasks)
                            {
                                @await Html.PartialAsync("_TaskCardPartial", task)
                            }
                        }
                    </div>
                </div>

                <!-- Cột 3: Cần sửa -->
                <div class="col" style="height:100%; display:flex; flex-direction:column; min-height:0;">
                    <div class="h"><span class="dot fix"></span>Cần sửa<span class="c">@Model.NeedsFixTasks.Count</span></div>
                    <div class="col-tasks" style="flex:1; overflow-y:auto; padding-right:2px;">
                        @if (Model.NeedsFixTasks.Count == 0)
                        {
                            <div class="empty">Trống</div>
                        }
                        else
                        {
                            @foreach (var task in Model.NeedsFixTasks)
                            {
                                @await Html.PartialAsync("_TaskCardPartial", task)
                            }
                        }
                    </div>
                </div>

                <!-- Cột 4: Đã merge (Danh sách 1 dòng + Xem tất cả) -->
                <div class="col" style="height:100%; display:flex; flex-direction:column; min-height:0; background:transparent; border:1px solid var(--line);">
                    <div class="h"><span class="dot ok"></span>Đã merge<span class="c">@Model.MergedTasks.Count</span></div>
                    @if (Model.MergedTasks.Count == 0)
                    {
                        <div class="empty">Trống</div>
                    }
                    else
                    {
                        <!-- Danh sách rút gọn 7 mục + +N Xem tất cả -->
                        <div class="mlist" id="mergedPreviewList" style="flex:1; overflow-y:auto;">
                            @foreach (var task in Model.MergedPreviewItems)
                            {
                                <div class="mi">
                                    <a href="/p/@task.Project/t/@task.Id">@task.Id</a>
                                    <span title="@task.Title">@task.Title</span>
                                </div>
                            }
                            @if (Model.MergedRemaining > 0)
                            {
                                <div class="mi" style="cursor:pointer" onclick="toggleAllMerged(true)">
                                    <a class="muted">+@Model.MergedRemaining</a>
                                    <span class="muted">Xem tất cả</span>
                                </div>
                            }
                        </div>

                        <!-- Danh sách đầy đủ khi bấm Xem tất cả -->
                        @if (Model.MergedRemaining > 0)
                        {
                            <div class="mlist" id="mergedAllList" style="display:none; flex:1; overflow-y:auto;">
                                @foreach (var task in Model.AllMergedOrdered)
                                {
                                    <div class="mi">
                                        <a href="/p/@task.Project/t/@task.Id">@task.Id</a>
                                        <span title="@task.Title">@task.Title</span>
                                    </div>
                                }
                                <div class="mi" style="cursor:pointer" onclick="toggleAllMerged(false)">
                                    <a class="muted">▲</a>
                                    <span class="muted">Thu gọn</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Tab 2: Kế hoạch -->
        <div id="tabPlanContent" style="display:none; flex:1; min-height:0; overflow-y:auto;">
            <div class="panel" style="min-height:100%;">
                <div class="hd">Kế hoạch triển khai</div>
                <div class="bd markdown-body">
                    @if (string.IsNullOrWhiteSpace(Model.Board.PlanMarkdown))
                    {
                        <div class="empty">Chưa có kế hoạch cho dự án này</div>
                    }
                    else
                    {
                        @MarkdownRenderer.Render(Model.Board.PlanMarkdown)
                    }
                </div>
            </div>
        </div>

        <!-- Tab 3: Lịch sử chạy -->
        <div id="tabRunsContent" style="display:none; flex:1; min-height:0; overflow-y:auto;">
            <div class="panel" style="min-height:100%;">
                <div class="hd">Lịch sử chạy<span class="sp"></span><span class="muted">@Model.Runs.Count lần</span></div>
                @if (Model.Runs.Count == 0)
                {
                    <div class="empty">Chưa có lần chạy nào cho dự án này</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Lượt</th>
                                <th>Kết quả</th>
                                <th class="num">Thời lượng</th>
                                <th class="num">Token</th>
                                <th>Lúc</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Runs)
                            {
                                var verdict = RunVerdicts.Classify(r);
                                var pillClass = verdict switch
                                {
                                    RunVerdict.Running => "pill run",
                                    RunVerdict.Success => "pill ok",
                                    RunVerdict.CreditsExhausted => "pill err",
                                    _ => "pill fix"
                                };
                                var verdictText = RunVerdicts.Label(verdict);
                                var duration = r.DurationSeconds.HasValue
                                    ? (r.DurationSeconds.Value >= 60 ? $"{(int)(r.DurationSeconds.Value / 60)}′" : $"{r.DurationSeconds.Value:F0}s")
                                    : "-";
                                var tokens = r.TotalTokens.HasValue
                                    ? (r.TotalTokens.Value >= 1_000_000 ? $"{r.TotalTokens.Value / 1_000_000.0:F2} tr" : (r.TotalTokens.Value >= 1_000 ? $"{r.TotalTokens.Value / 1_000.0:F1}k" : r.TotalTokens.Value.ToString("N0")))
                                    : "-";

                                <tr style="cursor:pointer" onclick="location.href='/p/@r.Project/t/@r.Task'">
                                    <td><b>@r.Task</b></td>
                                    <td>#@r.Attempt</td>
                                    <td><span class="@pillClass">@verdictText</span></td>
                                    <td class="num">@duration</td>
                                    <td class="num">@tokens</td>
                                    <td class="muted">@r.Time.ToString("HH:mm dd/MM")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <script>
        function switchProjectTab(tab) {
            document.querySelectorAll('.project-page .tabs .tab').forEach(function(t) {
                t.classList.remove('on');
            });

            var boardContent = document.getElementById('tabBoardContent');
            var planContent = document.getElementById('tabPlanContent');
            var runsContent = document.getElementById('tabRunsContent');

            boardContent.style.display = 'none';
            planContent.style.display = 'none';
            runsContent.style.display = 'none';

            if (tab === 'plan') {
                planContent.style.display = 'block';
                document.getElementById('tabPlanBtn').classList.add('on');
            } else if (tab === 'runs') {
                runsContent.style.display = 'block';
                document.getElementById('tabRunsBtn').classList.add('on');
            } else {
                boardContent.style.display = 'flex';
                document.getElementById('tabBoardBtn').classList.add('on');
            }
        }

        function toggleAllMerged(showAll) {
            var p = document.getElementById('mergedPreviewList');
            var a = document.getElementById('mergedAllList');
            if (p && a) {
                p.style.display = showAll ? 'none' : 'block';
                a.style.display = showAll ? 'block' : 'none';
            }
        }
    </script>
}
