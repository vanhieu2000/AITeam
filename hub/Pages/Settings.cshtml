@page
@model AITeam.Hub.Pages.SettingsModel
@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<div class="breadcrumb">
    <a href="/">Tổng quan</a>
    <span>›</span>
    <span>Cài đặt</span>
</div>

<div class="page-header">
    <h1 class="page-title">⚙️ Cài đặt cấu hình Team</h1>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">
        <span>✅ @Model.SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <span>⚠️ @Model.ErrorMessage</span>
    </div>
}

<div class="settings-layout">
    <!-- Cấu hình chung -->
    <div class="settings-card">
        <div class="settings-card-header">
            <h2>Cấu hình chung (team.json &amp; team.local.json)</h2>
            <p class="settings-card-subtitle">Các thiết lập về mô hình mặc định, số vòng review, thư mục làm việc và đường dẫn Antigravity CLI.</p>
        </div>
        <div class="settings-card-body">
            <form method="post" asp-page-handler="SaveSettings">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="defaultModel">Model mặc định (DefaultModel)</label>
                        <input type="text" id="defaultModel" name="defaultModel" class="form-control" value="@Model.Settings.DefaultModel" placeholder="Ví dụ: gemini-2.5-pro (để trống nếu dùng mặc định)" />
                        <span class="form-hint">Mô hình Antigravity dùng cho agent khi không chỉ định.</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="maxReviewRounds">Số vòng review tối đa (MaxReviewRounds)</label>
                        <input type="number" id="maxReviewRounds" name="maxReviewRounds" class="form-control" value="@Model.Settings.MaxReviewRounds" min="1" max="10" required />
                        <span class="form-hint">Giới hạn số vòng review trước khi Claude hỏi chủ dự án (1–10).</span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="projectsRoot">Thư mục chứa dự án (ProjectsRoot)</label>
                        <input type="text" id="projectsRoot" name="projectsRoot" class="form-control" value="@Model.Settings.ProjectsRoot" required />
                        <span class="form-hint">Ghi vào team.local.json (theo máy).</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="workRoot">Thư mục workspace của agent (WorkRoot)</label>
                        <input type="text" id="workRoot" name="workRoot" class="form-control" value="@Model.Settings.WorkRoot" required />
                        <span class="form-hint">Thư mục chứa worktree và logs khi agent thực hiện task.</span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="agyExe">Đường dẫn Antigravity CLI (AgyExe)</label>
                    <input type="text" id="agyExe" name="agyExe" class="form-control" value="@Model.Settings.AgyExe" required />
                    <span class="form-hint">Đường dẫn đầy đủ tới agy.exe trên máy này (ghi vào team.local.json).</span>
                </div>

                <div class="form-section-title">Chuyên môn của từng developer</div>
                @for (int i = 0; i < Model.Settings.Developers.Count; i++)
                {
                    var dev = Model.Settings.Developers[i];
                    <div class="developer-row">
                        <input type="hidden" name="developers[@i].Id" value="@dev.Id" />
                        <input type="hidden" name="developers[@i].Name" value="@dev.Name" />
                        <div class="developer-tag">
                            <strong>Agent @dev.Id</strong> (@dev.Name)
                        </div>
                        <div class="developer-focus-input">
                            <input type="text" name="developers[@i].Focus" class="form-control" value="@dev.Focus" placeholder="Lĩnh vực phụ trách" />
                        </div>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Lưu cấu hình team</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cấu hình từng dự án -->
    <div class="settings-card">
        <div class="settings-card-header">
            <h2>Cấu hình từng dự án (projects.json)</h2>
            <p class="settings-card-subtitle">Chỉnh sửa lệnh build, test, stack công nghệ và phân chia vùng code cho Agent A và B.</p>
        </div>
        <div class="settings-card-body">
            @if (Model.Projects.Count == 0)
            {
                <p class="text-muted">Chưa có dự án nào được đăng ký trong projects.json.</p>
            }
            else
            {
                @foreach (var proj in Model.Projects)
                {
                    <div class="project-settings-box">
                        <div class="project-settings-title">
                            <h3>📦 @proj.Name</h3>
                            <span class="badge">@proj.Repo</span>
                        </div>
                        <form method="post" asp-page-handler="SaveProject">
                            <input type="hidden" name="projectName" value="@proj.Name" />
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Công nghệ (Stack)</label>
                                    <input type="text" name="stack" class="form-control" value="@proj.Stack" />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Lệnh Build</label>
                                    <input type="text" name="build" class="form-control font-mono" value="@proj.Build" placeholder="dotnet build ..." />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Lệnh Test</label>
                                    <input type="text" name="test" class="form-control font-mono" value="@proj.Test" placeholder="dotnet test ..." />
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label class="form-label">Vùng phụ trách của Agent A</label>
                                    <input type="text" name="areaA" class="form-control" value="@(proj.Areas.TryGetValue("A", out var a) ? a : "")" placeholder="src/, tools/..." />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Vùng phụ trách của Agent B</label>
                                    <input type="text" name="areaB" class="form-control" value="@(proj.Areas.TryGetValue("B", out var b) ? b : "")" placeholder="ui/, pages/..." />
                                </div>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-secondary">Lưu dự án @proj.Name</button>
                            </div>
                        </form>
                    </div>
                }
            }
        </div>
    </div>
</div>
