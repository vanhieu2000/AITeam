@page
@model AITeam.Hub.Pages.SettingsModel
@{
    ViewData["Title"] = "Cài đặt";
    var isTeam = string.Equals(Model.Tab, "team", StringComparison.OrdinalIgnoreCase) || Model.CurrentProject == null;
}
<div class="panel" style="padding:14px;margin-bottom:14px">
    <strong>ChatGPT, model và ghi nhớ hội thoại</strong>
    <p class="muted">Cấu hình model, lời hướng dẫn, kiểm tra đăng nhập và lịch sử SQLite lưu trên máy.</p>
    <a class="btn pri" href="/Chat#settings">Mở cài đặt chat</a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(46, 160, 67, 0.15); border: 1px solid var(--ok); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--ok); margin-right: 8px;">✓</span>
        <span>@Model.SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

<section class="screen on" id="s-settings">
    <div class="set">
        <!-- Menu con bên trái: Team · từng dự án -->
        <div class="subnav">
            <a class="nav @(isTeam ? "on" : "")" href="/Settings?tab=team">Team</a>
            @* R-015 (Claude): thông tin dự án chuyển sang trang Dự án (đường dẫn máy ghi team.local.json, không ghi projects.json). *@
            <a class="nav" href="/Projects">Dự án →</a>
            <a class="nav" href="/Secrets">Két bí mật →</a>
        </div>

        <!-- Cột phải: Mỗi lần chỉ hiện 1 form -->
        @if (isTeam)
        {
            <!-- Form cấu hình Team -->
            <div class="panel">
                <div class="hd">
                    <span>Team</span>
                    <span class="sp"></span>
                    <span class="muted">team.json · team.local.json</span>
                </div>
                <div class="bd">
                    <form method="post" asp-page-handler="SaveSettings">
                        @Html.AntiForgeryToken()
                        <div class="form2">
                            <div class="field">
                                <label>Model mặc định <span class="info" title="Dùng khi task không chỉ định model (để trống nếu dùng mặc định của agy)">i</span></label>
                                <input class="inp" type="text" name="defaultModel" value="@Model.Settings.DefaultModel" placeholder="(mặc định của agy)" />
                            </div>
                            <div class="field">
                                <label>Số vòng review tối đa <span class="info" title="Giới hạn số vòng review trước khi Claude hỏi chủ dự án (1–10)">i</span></label>
                                <input class="inp" type="number" name="maxReviewRounds" value="@Model.Settings.MaxReviewRounds" min="1" max="10" required />
                            </div>
                            <div class="field">
                                <label>Thư mục dự án <span class="tag">máy này</span> <span class="info" title="Ghi vào team.local.json (theo máy)">i</span></label>
                                <input class="inp mono" type="text" name="projectsRoot" value="@Model.Settings.ProjectsRoot" required />
                            </div>
                            <div class="field">
                                <label>Thư mục agent <span class="tag">máy này</span> <span class="info" title="Thư mục chứa worktree và logs khi agent thực hiện task">i</span></label>
                                <input class="inp mono" type="text" name="workRoot" value="@Model.Settings.WorkRoot" required />
                            </div>
                            <div class="field wide">
                                <label>agy.exe <span class="tag">máy này</span> <span class="info" title="Đường dẫn đầy đủ tới agy.exe trên máy này (ghi vào team.local.json)">i</span></label>
                                <input class="inp mono" type="text" name="agyExe" value="@Model.Settings.AgyExe" required />
                            </div>
                            @for (int i = 0; i < Model.Settings.Developers.Count; i++)
                            {
                                var dev = Model.Settings.Developers[i];
                                <input type="hidden" name="developers[@i].Id" value="@dev.Id" />
                                <input type="hidden" name="developers[@i].Name" value="@dev.Name" />
                                <div class="field">
                                    <label>Agent @dev.Id — chuyên <span class="info" title="Chuyên môn phụ trách của Agent @dev.Id (@dev.Name)">i</span></label>
                                    <input class="inp" type="text" name="developers[@i].Focus" value="@dev.Focus" placeholder="Chuyên môn phụ trách" />
                                </div>
                            }
                        </div>
                        <div class="actions">
                            <a class="btn" href="/Settings?tab=team">Hoàn tác</a>
                            <button type="submit" class="btn pri">Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="panel">
                <div class="hd"><span>Thông tin dự án đã chuyển</span></div>
                <div class="bd">
                    <p>Lệnh build / test, vùng code, AI mặc định, trạng thái của từng dự án giờ sửa ở trang <a href="/Projects">Dự án</a>.</p>
                    <a class="btn pri" href="/Projects">Mở trang Dự án</a>
                </div>
            </div>
        }
    </div>
</section>
