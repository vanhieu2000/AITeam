@page
@model AITeam.Hub.Pages.ApprovalsModel
@using AITeam.Hub.Models
@{
    ViewData["Title"] = "Đơn duyệt";
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(46, 160, 67, 0.15); border: 1px solid var(--ok); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--ok); margin-right: 8px;">✓</span>
        <span>@Model.Message</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

<section class="screen on" id="s-approvals" style="min-width: 0;">
    <div class="muted" style="margin-bottom: 10px;">Hub chỉ ghi quyết định; merge / lệnh hệ thống do Claude chạy bằng team.ps1. Code đổi sau khi duyệt ⇒ phải duyệt lại.</div>

    <div class="tabs">
        <span class="tab on" id="tab-btn-pending" onclick="switchApprovalTab('pending')">Chờ duyệt<span class="c">@Model.Pending.Count</span></span>
        <span class="tab" id="tab-btn-decided" onclick="switchApprovalTab('decided')">Đã quyết<span class="c">@Model.Decided.Count</span></span>
    </div>

    @foreach (var group in new[] { (Key: "pending", Items: Model.Pending), (Key: "decided", Items: Model.Decided) })
    {
        <div id="tab-content-@group.Key" style="@(group.Key == "decided" ? "display: none;" : null)">
            @if (group.Items.Count == 0)
            {
                <div class="empty">@(group.Key == "pending" ? "Không có việc nào chờ anh duyệt." : "Chưa có quyết định nào.")</div>
            }
            else
            {
                <table class="approvals-table">
                    <colgroup>
                        <col class="approval-id" /><col class="approval-kind" /><col class="approval-project" />
                        <col class="approval-summary" /><col class="approval-time" /><col class="approval-status" />
                    </colgroup>
                    <thead>
                        <tr><th>Mã</th><th>Loại</th><th>Dự án/task</th><th>Nội dung tóm tắt</th><th>Lúc tạo</th><th>Trạng thái</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in group.Items)
                        {
                            var (pillCls, pillText) = a.Kind switch { ApprovalKind.Merge => ("pill rev", "MERGE"), ApprovalKind.Decision => ("pill run", "QUYẾT ĐỊNH"), _ => ("pill fix", "CẢI TIẾN QUY TRÌNH") };
                            var commitShort = string.IsNullOrEmpty(a.Commit) ? null : (a.Commit.Length > 7 ? a.Commit[..7] : a.Commit);
                            <tr>
                                <td>@a.Id</td>
                                <td><span class="@pillCls">@pillText</span></td>
                                <td>
                                    <div>@a.Project</div>
                                    @if (!string.IsNullOrEmpty(a.Task)) { <div>@a.Task</div> }
                                </td>
                                <td>
                                    <b>@a.Title</b>
                                    <details>
                                        <summary>Chi tiết</summary>
                                        <div class="approval-detail">@a.Detail</div>
                                        <div class="muted">@a.RequestedBy</div>
                                        @if (!string.IsNullOrEmpty(commitShort)) { <div><code>@commitShort</code></div> }
                                        @foreach (var link in a.Links) { <div><code>@link</code></div> }
                                    </details>
                                </td>
                                <td>@a.RequestedAt.ToString("HH:mm dd/MM")</td>
                                <td>
                                    @if (a.Status == ApprovalStatus.Pending)
                                    {
                                        <div class="pill rev">CHỜ DUYỆT</div>
                                        <form method="post" asp-page-handler="Decide">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@a.Id" />
                                            <textarea class="inp" name="note" rows="3" maxlength="500" placeholder="Ghi chú (tùy chọn)" aria-label="Ghi chú cho @a.Id"></textarea>
                                            <div class="row">
                                                <button class="btn pri" name="decision" value="approve">Duyệt</button>
                                                <button class="btn danger" name="decision" value="reject">Từ chối</button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        @if (a.Status == ApprovalStatus.Approved) { <span class="pill ok">ĐÃ DUYỆT</span> } else { <span class="pill err">ĐÃ TỪ CHỐI</span> }
                                        @if (a.DecidedAt.HasValue)
                                        {
                                            <div class="muted">@a.DecidedAt.Value.ToString("HH:mm dd/MM")</div>
                                        }
                                        @if (!string.IsNullOrEmpty(a.Note)) { <div class="approval-detail">@a.Note</div> }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</section>

<script>
    function switchApprovalTab(tab) {
        var isPending = tab === 'pending';
        document.getElementById('tab-btn-pending').classList.toggle('on', isPending);
        document.getElementById('tab-btn-decided').classList.toggle('on', !isPending);
        document.getElementById('tab-content-pending').style.display = isPending ? 'block' : 'none';
        document.getElementById('tab-content-decided').style.display = !isPending ? 'block' : 'none';
    }
</script>