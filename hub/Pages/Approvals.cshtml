@page
@model AITeam.Hub.Pages.ApprovalsModel
@using AITeam.Hub.Models
@using AITeam.Hub.Pages
@{
    // R-014 UI-04 (Claude). Thiết kế: docs/design/R-014-van-phong-ai.md mục 4.2, mockup docs/design/R-014-mockup.html #approvals.
    ViewData["Title"] = "Cần anh duyệt";
    var tab = Model.Tab ?? "owner";
}
<link rel="stylesheet" href="~/css/approvals.css" asp-append-version="true" />

@{
    // Thẻ một đơn duyệt (dùng cho tab Chờ anh và đơn cũ còn treo).
    async Task RenderCard(Approval a)
    {
        var (kindText, kindCss) = ApprovalsModel.KindLabel(a.Kind);
        var (riskText, riskCss) = ApprovalsModel.RiskLabel(a.Risk);
        var taskHref = ApprovalsModel.TaskHref(a.Project, a.Task);
        var commitShort = string.IsNullOrEmpty(a.Commit) ? null : (a.Commit.Length > 7 ? a.Commit[..7] : a.Commit);
        <article class="ap-card risk-@riskCss" aria-labelledby="ap-t-@a.Id">
            <div class="ap-ico ap-ico-@kindCss" aria-hidden="true">
                @if (a.Kind == ApprovalKind.Secret)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                }
                else if (a.Kind == ApprovalKind.Decision)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 015 .5c0 1.7-2.5 2-2.5 3.5M12 17h.01"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/></svg>
                }
            </div>
            <div class="ap-body">
                <div class="ap-title">
                    <span class="pill @kindCss">@kindText</span>
                    <span class="pill @riskCss">@riskText</span>
                    <b id="ap-t-@a.Id">@a.Title</b>
                </div>
                <div class="ap-detail">@MarkdownRenderer.Render(a.Detail)</div>
                <dl class="kv ap-kv">
                    <dt>Mã</dt><dd class="mono">@a.Id</dd>
                    <dt>Dự án</dt>
                    <dd>
                        @a.Project
                        @if (taskHref != null) { <text>· task </text><a href="@taskHref">@a.Task</a> }
                        @if (commitShort != null) { <text>· commit </text><code>@commitShort</code> }
                    </dd>
                    @if (a.Files.Count > 0)
                    {
                        <dt>File nhạy cảm</dt>
                        <dd>@foreach (var f in a.Files) { <code class="ap-file">@f</code> }</dd>
                    }
                    @if (a.Kind == ApprovalKind.Secret)
                    {
                        <dt>Khóa cần nhập</dt>
                        <dd>
                            @if (a.SecretName != null) { <code>@a.SecretName</code> } else { <span class="muted">(chưa ghi tên khóa)</span> }
                            <div class="muted">Anh tự nhập vào két cục bộ. Hub chỉ biết tên khóa, không bao giờ hiện giá trị.</div>
                            @if (a.SecretName != null) { <div>Hoặc gõ trong terminal: <code>team.ps1 secret-set -Name @a.SecretName</code></div> }
                        </dd>
                    }
                    @foreach (var link in a.Links) { <dt>Tài liệu</dt><dd><code>@link</code></dd> }
                    <dt>Xin bởi</dt><dd>@a.RequestedBy · <span class="num">@a.RequestedAt.ToString("HH:mm dd/MM")</span></dd>
                </dl>
            </div>
            <form method="post" asp-page-handler="Decide" class="ap-act ap-decide" data-id="@a.Id">
                <input type="hidden" name="id" value="@a.Id" />
                @if (a.Kind == ApprovalKind.Secret)
                {
                    <a class="btn cta" href="/Secrets">Mở két để nhập</a>
                }
                <label class="sr-only" for="note-@a.Id">Ghi chú cho @a.Id</label>
                <textarea class="inp" id="note-@a.Id" name="note" rows="2" maxlength="500" placeholder="Ghi chú (bắt buộc khi từ chối)"></textarea>
                <div class="row">
                    <button class="btn @(a.Kind == ApprovalKind.Secret ? "" : "cta")" name="decision" value="approve">@(a.Kind == ApprovalKind.Secret ? "Đã nhập xong" : "Đồng ý")</button>
                    <button class="btn danger" name="decision" value="reject">Từ chối…</button>
                </div>
            </form>
        </article>
    }
}


<p class="ap-sub">Chỉ việc nhạy cảm: bí mật, bảo mật, dữ liệu nhạy cảm, hành động ra ngoài, quyết định sản phẩm. Merge, QC và cải tiến nhỏ do Claude tự quyết và ghi nhật ký để anh xem lại.</p>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="status">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="tabs" role="tablist" aria-label="Nhóm đơn duyệt">
    <a class="tab @(tab == "owner" ? "on" : "")" role="tab" href="?tab=owner" data-tab="owner" aria-selected="@(tab == "owner" ? "true" : "false")">Chờ anh<span class="c num">@Model.OwnerPending.Count</span></a>
    <a class="tab @(tab == "claude" ? "on" : "")" role="tab" href="?tab=claude" data-tab="claude" aria-selected="@(tab == "claude" ? "true" : "false")">Claude đã tự quyết<span class="c num">@(Model.Decisions.Count + Model.ClaudePending.Count)</span></a>
    <a class="tab @(tab == "decided" ? "on" : "")" role="tab" href="?tab=decided" data-tab="decided" aria-selected="@(tab == "decided" ? "true" : "false")">Đã quyết<span class="c num">@Model.Decided.Count</span></a>
</div>

@* ───────── Tab 1: Chờ anh ───────── *@
<section class="ap-pane" id="pane-owner" role="tabpanel" @(tab == "owner" ? "" : "hidden")>
    @if (Model.OwnerPending.Count == 0)
    {
        <div class="empty">Không có việc nào chờ anh duyệt. Không có gì cần anh lúc này.</div>
    }
    @foreach (var a in Model.OwnerPending)
    {
        await RenderCard(a);
    }
</section>

@* ───────── Tab 2: Claude đã tự quyết ───────── *@
<section class="ap-pane" id="pane-claude" role="tabpanel" @(tab == "claude" ? "" : "hidden")>
    @if (Model.ClaudePending.Count > 0)
    {
        <h2 class="ap-h">Đơn cũ còn treo <span class="muted">(merge / cải tiến — Claude tự xử lý, anh có thể đóng hộ)</span></h2>
        @foreach (var a in Model.ClaudePending)
        {
            await RenderCard(a);
        }
    }

    <h2 class="ap-h">Nhật ký Claude tự quyết</h2>
    @if (Model.Decisions.Count == 0)
    {
        <div class="empty">Chưa có quyết định nào của Claude được ghi.</div>
    }
    else
    {
        <ol class="ap-log">
            @foreach (var d in Model.Decisions)
            {
                var taskHref = ApprovalsModel.TaskHref(d.Project, d.Task);
                <li class="ap-log-row @(d.Reopened ? "reopened" : "")">
                    <time class="num" datetime="@d.At.ToString("o")">@d.At.ToLocalTime().ToString("HH:mm dd/MM")</time>
                    <div class="ap-log-main">
                        <div class="ap-log-title">
                            <span class="pill rev">@(string.IsNullOrWhiteSpace(d.Kind) ? "khác" : d.Kind)</span>
                            <b>@d.Title</b>
                        </div>
                        <div class="muted ap-log-meta">
                            @d.Id
                            @if (taskHref != null) { <text>· task </text><a href="@taskHref">@d.Task</a> }
                            else if (!string.IsNullOrWhiteSpace(d.Task)) { <text>· task @d.Task</text> }
                            @if (!string.IsNullOrWhiteSpace(d.Request)) { <text>· yêu cầu </text><a href="/Request?id=@Uri.EscapeDataString(d.Request)">@d.Request</a> }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(d.Detail))
                        {
                            <div class="ap-log-detail">@d.Detail</div>
                        }
                        @if (d.Reopened)
                        {
                            <div class="ap-reopen-note"><span class="pill fix">Anh đã mở lại</span> @d.ReopenNote <span class="muted">@d.ReopenedAt?.ToLocalTime().ToString("HH:mm dd/MM")</span></div>
                        }
                    </div>
                    @if (!d.Reopened)
                    {
                        <details class="ap-reopen">
                            <summary class="btn sm ghost">Không đồng ý — mở lại</summary>
                            <form method="post" asp-page-handler="Reopen" class="ap-reopen-form">
                                <input type="hidden" name="id" value="@d.Id" />
                                <label class="sr-only" for="reopen-@d.Id">Lý do mở lại @d.Id</label>
                                <textarea class="inp" id="reopen-@d.Id" name="note" rows="2" maxlength="500" required placeholder="Vì sao anh không đồng ý? (bắt buộc)"></textarea>
                                <button class="btn sm danger" type="submit">Mở lại</button>
                            </form>
                        </details>
                    }
                </li>
            }
        </ol>
    }
</section>

@* ───────── Tab 3: Đã quyết ───────── *@
<section class="ap-pane" id="pane-decided" role="tabpanel" @(tab == "decided" ? "" : "hidden")>
    @if (Model.Decided.Count == 0)
    {
        <div class="empty">Chưa có quyết định nào.</div>
    }
    else
    {
        <table class="dash-table ap-decided">
            <thead><tr><th scope="col">Mã</th><th scope="col">Loại</th><th scope="col">Nội dung</th><th scope="col">Kết quả</th><th scope="col">Lúc quyết</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Decided)
                {
                    var (kindText, kindCss) = ApprovalsModel.KindLabel(a.Kind);
                    <tr>
                        <td class="mono">@a.Id</td>
                        <td><span class="pill @kindCss">@kindText</span></td>
                        <td>
                            <b>@a.Title</b>
                            <div class="muted">@a.Project@(string.IsNullOrEmpty(a.Task) ? "" : " · " + a.Task)</div>
                            @if (!string.IsNullOrEmpty(a.Note)) { <div class="ap-note">Ghi chú: @a.Note</div> }
                        </td>
                        <td>
                            @if (a.Status == ApprovalStatus.Approved) { <span class="pill ok">Đã duyệt</span> }
                            else { <span class="pill err">Đã từ chối</span> }
                        </td>
                        <td class="num">@a.DecidedAt?.ToString("HH:mm dd/MM")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<script>
    (function () {
        // Đổi tab không tải lại trang (link vẫn chạy khi tắt JS).
        var tabs = document.querySelectorAll('.tabs [data-tab]');
        tabs.forEach(function (t) {
            t.addEventListener('click', function (e) {
                e.preventDefault();
                tabs.forEach(function (x) {
                    var on = x === t;
                    x.classList.toggle('on', on);
                    x.setAttribute('aria-selected', on ? 'true' : 'false');
                    document.getElementById('pane-' + x.dataset.tab).hidden = !on;
                });
                history.replaceState(null, '', '?tab=' + t.dataset.tab);
            });
        });
        // Từ chối bắt buộc có lý do + xác nhận; đồng ý cũng xác nhận.
        document.querySelectorAll('form.ap-decide').forEach(function (f) {
            f.addEventListener('submit', function (e) {
                var btn = e.submitter, note = f.querySelector('textarea[name=note]');
                if (!btn) return;
                if (btn.value === 'reject') {
                    if (!note.value.trim()) {
                        e.preventDefault();
                        note.setCustomValidity('Từ chối thì cần ghi lý do.');
                        note.reportValidity();
                        note.addEventListener('input', function () { note.setCustomValidity(''); }, { once: true });
                        return;
                    }
                    if (!confirm('Từ chối ' + f.dataset.id + '?')) e.preventDefault();
                } else if (!confirm('Đồng ý ' + f.dataset.id + '?')) {
                    e.preventDefault();
                }
            });
        });
    })();
</script>
