@page
@model AITeam.Hub.Pages.IndexModel
@{
    ViewData["Title"] = "Tổng quan";
}

@section Actions {
    <span class="faint" style="font-size: 12px;">Cập nhật @DateTime.Now.ToString("HH:mm") · tự làm mới 15 giây</span>
}

<div class="kpis">
    <div class="kpi">
        <b>@Model.TotalProjects</b>
        <span>Dự án</span>
    </div>
    <div class="kpi run">
        <b>@Model.TotalAssigned</b>
        <span>Đang làm</span>
    </div>
    <div class="kpi rev">
        <b>@Model.TotalReview</b>
        <span>Chờ review</span>
    </div>
    <div class="kpi fix">
        <b>@Model.TotalNeedsFix</b>
        <span>Cần sửa</span>
    </div>
</div>

<div class="grid" style="grid-template-columns: minmax(0, 1fr) 340px;">
    <!-- Cột trái: Bảng dự án + Hoạt động gần đây -->
    <div class="grid" style="align-content: start;">
        <div class="panel">
            <div class="hd">Dự án</div>
            @if (Model.Projects.Count == 0)
            {
                <div class="empty">Chưa có dự án nào</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Tên</th>
                            <th class="num">Đang làm</th>
                            <th class="num">Review</th>
                            <th class="num">Cần sửa</th>
                            <th class="num">Đã merge</th>
                            <th>Hoạt động gần nhất</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Projects)
                        {
                            <tr>
                                <td>
                                    <a href="/p/@p.Info.Name" style="font-weight: 500;">@p.Info.Name</a>
                                </td>
                                <td class="num">
                                    @if (p.AssignedCount > 0)
                                    {
                                        <span class="pill run">@p.AssignedCount</span>
                                    }
                                    else
                                    {
                                        <span class="num faint">0</span>
                                    }
                                </td>
                                <td class="num">
                                    @if (p.ReviewCount > 0)
                                    {
                                        <span class="pill rev">@p.ReviewCount</span>
                                    }
                                    else
                                    {
                                        <span class="num faint">0</span>
                                    }
                                </td>
                                <td class="num">
                                    @if (p.NeedsFixCount > 0)
                                    {
                                        <span class="pill fix">@p.NeedsFixCount</span>
                                    }
                                    else
                                    {
                                        <span class="num faint">0</span>
                                    }
                                </td>
                                <td class="num">@p.MergedCount</td>
                                <td class="muted" style="overflow: hidden; text-overflow: ellipsis; max-width: 220px;" title="@p.LatestActivity">
                                    @p.LatestActivity
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="panel">
            <div class="hd">Hoạt động gần đây</div>
            @if (Model.RecentActivities.Count == 0)
            {
                <div class="empty">Chưa có hoạt động nào</div>
            }
            else
            {
                <table>
                    <tbody>
                        @foreach (var act in Model.RecentActivities)
                        {
                            <tr>
                                <td class="muted" style="width: 56px;">@act.Time.ToString("HH:mm")</td>
                                <td style="width: 105px;">
                                    @switch (act.Verdict)
                                    {
                                        case AITeam.Hub.Services.RunVerdict.Success:
                                            <span class="pill ok">Thành công</span>
                                            break;
                                        case AITeam.Hub.Services.RunVerdict.CreditsExhausted:
                                            <span class="pill err">Hết credits</span>
                                            break;
                                        case AITeam.Hub.Services.RunVerdict.Error:
                                            <span class="pill fix">Lỗi</span>
                                            break;
                                        default:
                                            <span class="pill n">@AITeam.Hub.Services.RunVerdicts.Label(act.Verdict)</span>
                                            break;
                                    }
                                </td>
                                <td style="overflow: hidden; text-overflow: ellipsis; max-width: 280px;">
                                    <a href="/p/@act.Project/t/@act.Task"><b>@act.Task</b></a>
                                    <span class="muted">· @act.Project</span>
                                </td>
                                <td class="muted num">lượt @act.Attempt</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Cột phải: Agent đang chạy + Tình trạng máy -->
    <div class="grid" style="align-content: start;">
        <partial name="_RunningAgentsPartial" model="Model.RunningAgents" />
        <partial name="_HealthPanelPartial" model="Model.HealthItems" />
    </div>
</div>
