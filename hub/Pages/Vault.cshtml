@page "/Secrets"
@model AITeam.Hub.Pages.VaultModel
@{
    ViewData["Title"] = "Bí mật";
}

@section Actions {
    <span class="info" title="Mã hóa DPAPI (người dùng Windows hiện tại), lưu ở %USERPROFILE%\.aiteam\vault.json. Không bao giờ hiện lại giá trị.">i</span>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(46, 160, 67, 0.15); border: 1px solid var(--ok); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--ok); margin-right: 8px;">✓</span>
        <span>@Model.SuccessMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

<section class="screen on" id="s-secrets">
    <div class="grid" style="grid-template-columns: 380px 1fr; gap: 14px; align-items: start;">
        <!-- Cột trái: Thêm bí mật + Xuất .env.local -->
        <div class="grid" style="align-content: start; gap: 14px;">
            <!-- Panel Thêm bí mật -->
            <div class="panel">
                <div class="hd">Thêm bí mật</div>
                <div class="bd grid" style="gap: 10px;">
                    <form method="post" asp-page-handler="Add">
                        @Html.AntiForgeryToken()
                        <div class="field" style="margin-bottom: 10px;">
                            <label>Tên <span class="faint">(A-Z, 0-9, _)</span></label>
                            <input class="inp mono" type="text" name="secretName" placeholder="DB_PASSWORD" required pattern="^[A-Za-z_][A-Za-z0-9_]*$" />
                        </div>
                        <div class="field" style="margin-bottom: 10px;">
                            <label>Giá trị</label>
                            <input class="inp" type="password" name="secretValue" autocomplete="off" required placeholder="Nhập giá trị bí mật" />
                        </div>
                        <div class="row" style="justify-content: flex-end;">
                            <button type="submit" class="btn pri">Lưu</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Panel Xuất .env.local -->
            <div class="panel">
                <div class="hd">
                    <span>Xuất .env.local</span>
                    <span class="info" title="Chỉ xuất khi .env.local đã nằm trong .gitignore của dự án.">i</span>
                </div>
                <div class="bd grid" style="gap: 10px;">
                    <form method="post" asp-page-handler="ExportEnv" id="exportForm">
                        @Html.AntiForgeryToken()
                        <div class="field" style="margin-bottom: 10px;">
                            <select class="inp" name="project" required>
                                <option value="">Chọn dự án…</option>
                                @foreach (var p in Model.Projects)
                                {
                                    <option value="@p.Name">@p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="row" style="justify-content: flex-end;">
                            <button type="submit" class="btn" @(Model.SecretNames.Count == 0 || Model.Projects.Count == 0 ? "disabled" : "")>Xuất</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Danh sách bí mật đã lưu -->
        <div class="panel">
            <div class="hd">
                <span>Đã lưu</span>
                <span class="muted">@Model.SecretNames.Count</span>
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width: 28px;">
                            <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this)" title="Chọn tất cả để xuất" />
                        </th>
                        <th>Tên</th>
                        <th style="width: 80px; text-align: right;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SecretNames.Count == 0)
                    {
                        <tr>
                            <td colspan="3"><div class="empty">Kho trống</div></td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var name in Model.SecretNames)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="selectedNames" value="@name" form="exportForm" />
                                </td>
                                <td>
                                    <span class="mono">🔑 @name</span>
                                </td>
                                <td style="text-align: right;">
                                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bí mật \'@name\' không?');" style="display: inline; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="name" value="@name" />
                                        <button type="submit" class="btn sm danger">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
    function toggleSelectAll(source) {
        var checkboxes = document.querySelectorAll('input[name="selectedNames"]');
        for (var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].checked = source.checked;
        }
    }
</script>
