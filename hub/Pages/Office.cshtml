@page "/"
@model AITeam.Hub.Pages.OfficeModel
@using AITeam.Hub.Services
@using AITeam.Hub.Models
@inject WorkOverviewService WorkOverview
@inject IApprovalService Approvals
@{
    ViewData["Title"] = "Văn phòng";
    // R-014 (Claude): trang chủ là bảng điều khiển. Khung giao việc + nghiên cứu theo phiếu chỉ hiện khi mở từ nút chat nổi (?embed=1).
    // Mọi POST trả trang đầy đủ (Chat / nghiên cứu khi lỗi) đều xuất phát từ khung trợ lý ⇒ hiện lại khung đó.
    var embed = Request.Query["embed"] == "1" || HttpMethods.IsPost(Request.Method);
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="panel" role="alert" style="border-color:var(--err);background:var(--err-soft);color:var(--err)">@Model.Error</div>
}

@if (embed)
{
    @if (Model.SelectedThread != null)
    {
        <p><a class="btn sm" href="@Url.Page("/Request", new { id = Model.SelectedThread.Id })" target="_top">Chi tiết @Model.SelectedThread.Id</a></p>
    }
    <div class="office-workspace">
        <section class="office-chat panel">
            <h3>Giao việc cho Claude</h3>
            <partial name="_OfficeChat" model="Model" />
            <form method="post" asp-page-handler="Chat" hx-post="/?handler=Chat" hx-target="#office-chat-thread" hx-swap="outerHTML"
                  hx-on::after-request="if(event.detail.xhr.getResponseHeader('HX-Trigger') === 'office-chat-sent') this.elements.text.value = ''">
                <label for="office-request-select">Phiếu</label>
                <select id="office-request-select" class="inp" name="requestId" hx-get="/?handler=Chat" hx-trigger="change" hx-target="#office-chat-thread" hx-swap="outerHTML">
                    <option value="">Tạo yêu cầu mới</option>
                    @if (!string.IsNullOrEmpty(Model.RequestId) && Model.SelectedThread == null)
                    {
                        <option value="@Model.RequestId" selected>Phiếu không hợp lệ</option>
                    }
                    @foreach (var thread in Model.Threads)
                    {
                        <option value="@thread.Id" selected="@(thread.Id == Model.RequestId)">@thread.Id · @thread.Title</option>
                    }
                </select>
                <label for="office-project">Dự án</label>
                <select id="office-project" class="inp" name="project">
                    @foreach (var project in Model.ChatProjects)
                    {
                        <option value="@project.Name">@project.Name</option>
                    }
                </select>
                <label for="office-text">Nội dung gửi Claude</label>
                <textarea id="office-text" class="inp" name="text" rows="5" maxlength="4000"></textarea>
                <button type="submit" class="btn cta" disabled="@(Model.ChatProjects.Count == 0)">Gửi yêu cầu</button>
            </form>
        </section>
    </div>
    <partial name="_OfficeResearch" model="Model" />
    return;
}

@{
    var work = WorkOverview.Read();
    var today = DateTime.Today;
    var running = work.Tasks.Count(t => t.Status is OfficeTaskStatus.Running or OfficeTaskStatus.Gate);
    var review = work.Tasks.Count(t => t.Status == OfficeTaskStatus.Review);
    var doneToday = work.Tasks.Count(t => t.Status == OfficeTaskStatus.Merged && t.MergedAt?.Date == today);
    var stuck = work.Tasks.Count(t => t.Status is OfficeTaskStatus.NeedsFix or OfficeTaskStatus.Blocked);
    var ownerPending = Approvals.GetAll().Where(a => a.Status == ApprovalStatus.Pending && a.Kind != ApprovalKind.Merge && a.Kind != ApprovalKind.Improvement).ToList();
    var openRequests = Model.Threads.Where(t => t.Status.Contains("🟡") || t.Status.Contains("Đang", StringComparison.OrdinalIgnoreCase)).Take(6).ToList();
    var events = work.Tasks
        .Select(t => new { Card = t, At = t.MergedAt.HasValue ? new DateTimeOffset(t.MergedAt.Value) : t.UpdatedAt })
        .Where(x => x.At.HasValue && x.Card.Status != OfficeTaskStatus.Cancelled)
        .OrderByDescending(x => x.At).Take(25).ToList();
    string Pill(OfficeTaskStatus s) => s switch
    {
        OfficeTaskStatus.Running or OfficeTaskStatus.Gate => "run",
        OfficeTaskStatus.Review => "rev",
        OfficeTaskStatus.NeedsFix or OfficeTaskStatus.Blocked => "fix",
        OfficeTaskStatus.Merged => "ok",
        _ => "n"
    };
    string TaskUrl(TaskCard t) => $"/p/{Uri.EscapeDataString(t.Project)}/t/{Uri.EscapeDataString(t.Id)}";
}

@section Actions {
    <span class="muted num" style="font-size:12.5px">Cập nhật @DateTime.Now.ToString("HH:mm:ss")</span>
    <button class="btn cta" type="button" data-chat="task">+ Giao việc mới</button>
}

<link rel="stylesheet" href="~/css/office.css" asp-append-version="true" />

@* UI-10 (Claude, chủ dự án 04/11): trang vừa khít màn hình, không cuộn cả trang; mỗi nội dung 1 thẻ, thẻ dài tự cuộn bên trong. *@
<div class="office">
@if (ownerPending.Count > 0)
{
    <div class="dash-alert office-alert" role="status">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M12 8v5M12 16h.01"/></svg>
        <div class="office-alert-text"><b class="num">@ownerPending.Count việc cần anh duyệt</b> · @string.Join(" · ", ownerPending.Take(2).Select(a => a.Title))</div>
        <a class="btn sm" href="/Approvals">Xem ngay</a>
    </div>
}

    <div class="kpis office-kpis">
        <a class="kpi run" href="/Tracking?state=running"><span class="l">Đang chạy</span><span class="v num">@running</span><span class="d muted">AI đang code / cổng KT</span></a>
        <a class="kpi rev" href="/Tracking?state=review"><span class="l">Chờ Claude review</span><span class="v num">@review</span><span class="d muted">sau cổng kiểm tra</span></a>
        <a class="kpi ok" href="/Tracking?state=done"><span class="l">Xong hôm nay</span><span class="v num">@doneToday</span><span class="d muted">đã merge vào main</span></a>
        <a class="kpi @(stuck > 0 ? "warn" : "")" href="/Tracking?state=fix"><span class="l">Cần sửa / bị chặn</span><span class="v num">@stuck</span><span class="d muted">@(stuck > 0 ? "cần xử lý" : "không có")</span></a>
    </div>

    <div class="office-board">
        <div class="office-main">
        <section class="panel office-agents" aria-labelledby="desks-h">
            <div class="hd"><span id="desks-h">Bàn làm việc</span>
                @if (Model.View is { } dv)
                {
                    <span class="muted num">@dv.Working đang làm · @dv.Review chờ review · @dv.Idle rảnh</span>
                }
            </div>
            <div class="bd office-scroll" hx-get="?handler=Desks" hx-trigger="every 10s" hx-target="#office-desks" hx-swap="outerHTML">
                <partial name="_OfficeDesks" model="Model" />
            </div>
            @if (Model.ControlsEnabled)
            {
                <partial name="_OfficeControl" model="Model" />
            }
        </section>
            <section class="panel office-reqs" aria-labelledby="req-h">
                <div class="hd"><span id="req-h">Yêu cầu đang mở</span><span class="muted num">@openRequests.Count</span><span class="sp"></span><a class="btn sm ghost" href="/Tracking?view=list">Tất cả</a></div>
                <div class="bd office-scroll">
                @if (openRequests.Count == 0)
                {
                    <p class="office-empty">Không có yêu cầu nào đang làm. Bấm “+ Giao việc mới” để bắt đầu.</p>
                }
                else
                {
                    <ul class="office-req-list">
                    @foreach (var r in openRequests)
                    {
                        var codes = r.Tasks.Select(t => t.Code).ToHashSet(StringComparer.OrdinalIgnoreCase);
                        var cards = work.Tasks.Where(c => codes.Contains(HubMetricReader.TaskCode(c.Task.Id))).ToList();
                        var total = Math.Max(codes.Count, cards.Count);
                        var merged = cards.Count(c => c.Status == OfficeTaskStatus.Merged);
                        var pct = total == 0 ? 0 : (int)Math.Round(100.0 * merged / total);
                        <li>
                            <a class="office-req-title" href="@Url.Page("/Request", new { id = r.Id })" title="@r.Title"><b>@r.Id</b> @r.Title</a>
                            <div class="office-req-meter"><div class="meter" role="img" aria-label="@merged trên @total task đã xong"><i style="width:@(pct)%"></i></div><span class="num muted">@merged/@total</span></div>
                        </li>
                    }
                    </ul>
                }
                </div>
            </section>
        </div>

        <div class="office-side">

            <section class="panel office-events" aria-labelledby="ev-h">
                <div class="hd"><span id="ev-h">Sự kiện gần đây</span><span class="sp"></span><a class="btn sm ghost" href="/Tracking">Theo dõi việc</a></div>
                <div class="bd office-scroll">
                @if (events.Count == 0)
                {
                    <p class="office-empty">Chưa có sự kiện.</p>
                }
                <ul class="feed office-feed">
                    @foreach (var e in events)
                    {
                        <li>
                            <time class="num" datetime="@e.At!.Value.ToString("o")">@e.At.Value.ToLocalTime().ToString("dd/MM HH:mm")</time>
                            <span class="pill @Pill(e.Card.Status)">@WorkOverviewService.Label(e.Card.Status)</span>
                            <span class="office-feed-text" title="@e.Card.Task.Title"><a href="@TaskUrl(e.Card.Task)">@HubMetricReader.TaskCode(e.Card.Task.Id)</a> @e.Card.Task.Title</span>
                        </li>
                    }
                </ul>
                @foreach (var w in work.Warnings.Take(1))
                {
                    <p class="faint" style="font-size:12px">@w</p>
                }
                </div>
            </section>
        </div>
    </div>
</div>
