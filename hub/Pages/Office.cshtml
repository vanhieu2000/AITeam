@page "/"
@model AITeam.Hub.Pages.OfficeModel
@{ ViewData["Title"] = "Văn phòng"; }
<p><a class="btn" href="/Work">Công việc toàn hệ thống</a></p>
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="panel" style="border-color:#dc2626;background:#fef2f2;color:#b91c1c">@Model.Error</div>
}

@if (Model.View is { } v)
{
    <div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px">
        <span class="muted">Cập nhật @v.At.ToString("HH:mm:ss") · tự làm mới 10 giây</span>
        <div class="row" style="gap:6px;flex-wrap:wrap">
            <span class="pill run">@v.Working đang làm</span>
            <span class="pill rev">@v.Review chờ review</span>
            <span class="pill ok">@v.Idle rảnh</span>
            <span class="pill err">@v.Resting nghỉ</span>
        </div>
    </div>
}

@if(Model.SelectedThread!=null){<p><a class="btn" href="@Url.Page("/Request",new{id=Model.SelectedThread.Id})">Chi tiết @Model.SelectedThread.Id</a></p>}
<div class="office-workspace">
    <section class="office-agents" hx-get="?handler=Desks" hx-trigger="every 10s" hx-target="#office-desks" hx-swap="outerHTML">
        <partial name="_OfficeDesks" model="Model" />
        @if (Model.ControlsEnabled)
        {
            <partial name="_OfficeControl" model="Model" />
        }
        <partial name="_OfficeResearch" model="Model" />
    </section>
    <section class="office-chat panel">
        <h3>Chat giao việc</h3>
        <partial name="_OfficeChat" model="Model" />
        <form method="post" asp-page-handler="Chat" hx-post="/?handler=Chat" hx-target="#office-chat-thread" hx-swap="outerHTML"
              hx-on::after-request="if(event.detail.xhr.getResponseHeader('HX-Trigger') === 'office-chat-sent') this.elements.text.value = ''">
            <label for="office-request-select">Phiếu</label>
            <select id="office-request-select" class="inp" name="requestId" hx-get="/?handler=Chat" hx-trigger="change" hx-target="#office-chat-thread" hx-swap="outerHTML">
                <option value="">Tạo yêu cầu mới</option>
                @if (!string.IsNullOrEmpty(Model.RequestId) && Model.SelectedThread == null)
                {
                    <option value="@Model.RequestId" selected>Phiếu không hợp lệ</option>
                }
                @foreach (var thread in Model.Threads)
                {
                    <option value="@thread.Id" selected="@(thread.Id == Model.RequestId)">@thread.Id · @thread.Title</option>
                }
            </select>
            <label for="office-project">Dự án</label>
            <select id="office-project" class="inp" name="project">
                @foreach (var project in Model.ChatProjects)
                {
                    <option value="@project.Name">@project.Name</option>
                }
            </select>
            <label for="office-text">Nội dung gửi Claude</label>
            <textarea id="office-text" class="inp" name="text" rows="5" maxlength="4000"></textarea>
            <button type="submit" class="btn pri" disabled="@(Model.ChatProjects.Count == 0)">Gửi yêu cầu</button>
        </form>
    </section>
</div>
<section id="office-chat-shortcut" class="panel" style="margin-top:16px;padding:16px;display:flex;flex-wrap:wrap;align-items:center;gap:12px;min-width:0">
    <div style="flex:1;min-width:0;overflow-wrap:anywhere"><strong>Trò chuyện AI</strong><p class="muted">@(Model.LatestAiConversation?.Title ?? Model.AiConversationNotice ?? "Chưa có hội thoại. Bắt đầu trò chuyện với AI.")</p></div>
    <a class="btn pri" href="/Chat">Mở trò chuyện</a>
</section>
