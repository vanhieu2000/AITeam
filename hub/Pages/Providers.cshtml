@page "/Providers"
@model AITeam.Hub.Pages.ProvidersModel
@{ ViewData["Title"] = "Provider"; }

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(46, 160, 67, 0.15); border: 1px solid var(--ok); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--ok); margin-right: 8px;">✓</span><span>@Model.Message</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span><span>@Model.ErrorMessage</span>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span><span>@Model.Error</span>
    </div>
}

<section class="screen on" id="s-providers">
    <p class="muted" style="margin: 0 0 12px 0; font-size: 13px;">
        Provider = AI chạy bằng dòng lệnh chính thức của từng hãng. Hết hạn mức ⇒ tự nghỉ tới giờ ghi trong câu báo lỗi rồi dùng lại. Bấm 'Hết nghỉ' khi anh biết hạn mức đã có lại (vd. vừa đổi tài khoản).
    </p>
    <div class="grid" style="gap: 14px;">
        <div class="panel" style="overflow-x: auto;">
            <div class="hd"><span>Provider</span></div>
            <table>
                <thead>
                    <tr>
                        <th>Id</th><th>Loại</th><th>Vai trò</th><th>Model</th><th>Tối đa job</th><th>Trạng thái</th><th>Kiểm tra</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td><b>@r.Id</b></td>
                            <td>@r.Kind</td>
                            <td>@r.Roles</td>
                            <td><code>@r.Model</code></td>
                            <td>@r.MaxConcurrent</td>
                            <td>
                                @if (!r.Enabled)
                                {
                                    <span class="pill n">Đang tắt</span>
                                }
                                else if (r.RestUntil.HasValue)
                                {
                                    <span class="pill err" title="@($"{r.RestReason}: {r.RestDetail}")">Nghỉ tới @r.RestUntil.Value.ToString("HH:mm dd/MM")</span>
                                }
                                else
                                {
                                    <span class="pill ok">Sẵn sàng</span>
                                }
                            </td>
                            <td>
                                <button class="btn sm" hx-get="?handler=Health&id=@r.Id" hx-target="#health-@r.Id" hx-swap="innerHTML">Kiểm tra</button>
                                <span id="health-@r.Id"></span>
                            </td>
                            <td>
                                @if (r.RestUntil.HasValue)
                                {
                                    <form method="post" asp-page-handler="Clear" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button class="btn sm">Hết nghỉ</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel">
            <div class="hd"><span>Thứ tự dự phòng</span></div>
            <div class="bd grid" style="gap: 6px;">
                @foreach (var (role, chain) in Model.Routing)
                {
                    <div><b>@role</b>: <code>@chain</code></div>
                }
            </div>
        </div>

        <div class="panel" style="overflow-x: auto;">
            <div class="hd"><span>Lịch sử nghỉ gần đây</span></div>
            @if (Model.History.Count == 0)
            {
                <div class="empty" style="padding: 24px 0;">Chưa có lần nghỉ nào.</div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Provider</th><th>Lý do</th><th>Từ</th><th>Tới</th><th>Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr>
                                <td><b>@h.ProviderId</b></td>
                                <td>@h.Reason</td>
                                <td>@h.At.ToString("HH:mm dd/MM")</td>
                                <td>@h.Until.ToString("HH:mm dd/MM")</td>
                                <td style="max-width: 420px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@h.Detail">@h.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</section>
