@page
@model AITeam.Hub.Pages.AgentsModel
@{
    ViewData["Title"] = "Agent";
}

@section Actions {
    <span class="faint" style="font-size:12px">tự làm mới 15 giây</span>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(46, 160, 67, 0.15); border: 1px solid var(--ok); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--ok); margin-right: 8px;">✓</span>
        <span>@Model.Message</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="row" style="padding: 8px 14px; margin-bottom: 12px; background: rgba(248, 81, 73, 0.15); border: 1px solid var(--err); border-radius: var(--r); font-size: 13px;">
        <span style="font-weight: 600; color: var(--err); margin-right: 8px;">✗</span>
        <span>@Model.ErrorMessage</span>
    </div>
}

<section class="screen on" id="s-agents">
    <div style="margin-bottom: 14px;">
        <partial name="_AgentsRunningTablePartial" model="Model.RunningAgents" />
    </div>

    <div class="panel">
        <div class="hd">
            <span>Lịch sử</span>
            <span class="sp"></span>
            <div class="seg">
                <a href="/Agents?filter=All@(Model.SelectedProject != null ? $"&project={Model.SelectedProject}" : "")" class="@(Model.Filter == AITeam.Hub.Services.RunFilter.All ? "on" : "")">Tất cả</a>
                <a href="/Agents?filter=Errors@(Model.SelectedProject != null ? $"&project={Model.SelectedProject}" : "")" class="@(Model.Filter == AITeam.Hub.Services.RunFilter.Errors ? "on" : "")">Lỗi</a>
                <a href="/Agents?filter=Success@(Model.SelectedProject != null ? $"&project={Model.SelectedProject}" : "")" class="@(Model.Filter == AITeam.Hub.Services.RunFilter.Success ? "on" : "")">Thành công</a>
            </div>
            <form method="get" action="/Agents" style="margin: 0; display: inline-flex;">
                <input type="hidden" name="filter" value="@Model.Filter" />
                <select name="project" class="inp" style="width: 170px; height: 28px;" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedProject) ? "selected" : null)">Mọi dự án</option>
                    @foreach (var p in Model.Projects)
                    {
                        <option value="@p.Name" selected="@(Model.SelectedProject == p.Name ? "selected" : null)">@p.Name</option>
                    }
                </select>
            </form>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Task</th>
                    <th>Lượt</th>
                    <th>Kết quả</th>
                    <th class="num">Thời lượng</th>
                    <th class="num">Token</th>
                    <th>Lúc</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RunPage.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6"><div class="empty">Không có lần chạy nào</div></td>
                    </tr>
                }
                else
                {
                    @foreach (var run in Model.RunPage.Items)
                    {
                        var verdict = AITeam.Hub.Services.RunVerdicts.Classify(run);
                        var pillClass = verdict switch
                        {
                            AITeam.Hub.Services.RunVerdict.Success => "pill ok",
                            AITeam.Hub.Services.RunVerdict.CreditsExhausted => "pill err",
                            AITeam.Hub.Services.RunVerdict.Error => "pill err",
                            AITeam.Hub.Services.RunVerdict.Running => "pill run",
                            _ => "pill"
                        };

                        <tr data-drawer style="cursor: pointer;"
                            hx-get="/Agents?handler=RunDrawer&project=@run.Project&task=@run.Task&attempt=@run.Attempt"
                            hx-target="#drawer-container"
                            hx-swap="innerHTML"
                            title="Bấm để xem chi tiết lần chạy">
                            <td><b>@run.Task</b> <span class="muted">@run.Project</span></td>
                            <td>#@run.Attempt</td>
                            <td><span class="@pillClass">@AITeam.Hub.Services.RunVerdicts.Label(verdict)</span></td>
                            <td class="num">@AITeam.Hub.Pages.AgentsModel.FormatDuration(run.DurationSeconds)</td>
                            <td class="num">@AITeam.Hub.Pages.AgentsModel.FormatTokens(run.TotalTokens)</td>
                            <td class="muted">@run.Time.ToString("HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="row" style="justify-content: space-between; padding: 8px 14px; border-top: 1px solid var(--line);">
            <span class="muted" style="font-size: 12.5px;">@Model.PaginationSummary</span>
            <span class="row" style="gap: 4px;">
                @if (Model.RunPage.Page > 1)
                {
                    <a class="btn sm" href="/Agents?filter=@Model.Filter@(Model.SelectedProject != null ? $"&project={Model.SelectedProject}" : "")&page=@(Model.RunPage.Page - 1)">‹</a>
                }
                else
                {
                    <button class="btn sm" disabled>‹</button>
                }

                @if (Model.RunPage.Page < Model.RunPage.PageCount)
                {
                    <a class="btn sm" href="/Agents?filter=@Model.Filter@(Model.SelectedProject != null ? $"&project={Model.SelectedProject}" : "")&page=@(Model.RunPage.Page + 1)">›</a>
                }
                else
                {
                    <button class="btn sm" disabled>›</button>
                }
            </span>
        </div>
    </div>
</section>

<div id="drawer-container"></div>
