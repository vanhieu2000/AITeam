{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git fetch origin*": "allow",
      "git merge --no-edit origin/main*": "allow",
      "git add *": "allow",
      "git commit -m *": "allow",
      "dotnet build *": "allow",
      "dotnet test *": "allow"
    }
  }
}
